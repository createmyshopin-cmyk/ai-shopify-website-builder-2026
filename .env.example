# Shopify embedded app (mvp/)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_themes,write_metaobject_definitions,write_metaobjects,write_products,write_themes
SHOPIFY_APP_URL=https://your-tunnel.example.com

# Supabase (https://supabase.com/dashboard/project/_/settings/database)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — copy "Transaction pooler" URI from Supabase (port 6543, add ?pgbouncer=true)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Prisma migrations — copy "Session pooler" or "Direct connection" URI (port 5432)
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Local Postgres alternative (docker compose)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/theme_editor
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/theme_editor

# NestJS API (packages/api)
API_PORT=3001
PROJECT_API_URL=http://localhost:3001
# Production (Railway): PROJECT_API_URL=https://ai-shopify-website-builder-2026-production.up.railway.app
REPO_ROOT=.
BASE_THEME_PATH=./base theme

# AI agents — set MOCK_AI=true to skip OpenRouter in dev (uses golden mock outputs)
MOCK_AI=false
MOCK_SHOPIFY_UPLOAD=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Optional dev tokens (local only — never commit real values)
SHOPIFY_DEV_ACCESS_TOKEN=
SHOPIFY_SOURCE_THEME_NAME=themepro-v2

# Redis (Phase 4+)
REDIS_URL=redis://localhost:6379
