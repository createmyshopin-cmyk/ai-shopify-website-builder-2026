r":["inf_1","inf_2","inf_3","inf_4","inf_5","inf_6","inf_7","inf_8","inf_9","inf_10"],"settings":{"heading":"<p>SEEN IN THE WILD<\/p>","color_scheme":"scheme-1","padding-block-start":64,"padding-block-end":64}},"editorial-testimonials_kragxh":{"type":"editorial-testimonials","blocks":{"item_0":{"type":"review","settings":{"stars":5,"title":"<p>A Wardrobe Staple<\/p>","quote":"<p>I wore my Anu to a dinner party, not a wedding. The embroidery caught light all evening without feeling costume-like.<\/p>","author":"Priya M.","product_info":""}},"item_1":{"type":"review","settings":{"stars":5,"title":"<p>Finally, a saree that fits my life<\/p>","quote":"<p>The included blouse piece saved me so much time. I didn't have to hunt for matching fabric; I just took it straight to my tailor.<\/p>","author":"Deepa R.","product_info":""}},"item_2":{"type":"review","settings":{"stars":5,"title":"<p>Editorial Quality<\/p>","quote":"<p>The weight of the Anu is perfect. I wore it for 8 hours at an art gallery opening and never felt the urge to adjust or fix it.<\/p>","author":"Leila S.","product_info":""}},"item_3":{"type":"review","settings":{"stars":5,"title":"<p>Authentic Craft<\/p>","quote":"<p>You can feel the hand-embroidery. It's subtle, elegant, and feels like a real piece of heritage that I can actually wear on a Tuesday.<\/p>","author":"Aisha K.","product_info":""}},"item_4":{"type":"review","settings":{"stars":5,"title":"<p>Beautifully Packaged<\/p>","quote":"<p>Opening the Anu felt like receiving a piece of history. The silk-cotton blend is so soft against the skin.<\/p>","author":"Roshni V.","product_info":""}},"item_5":{"type":"review","settings":{"stars":5,"title":"<p>Unapologetically Mine<\/p>","quote":"<p>Ardraknair gets it. The Anu doesn't feel like a costume; it feels like me. It's contemporary heritage at its best.<\/p>","author":"Tanvi B.","product_info":""}}},"block_order":["item_0","item_1","item_2","item_3","item_4","item_5"],"settings":{"heading":"<p>TESTIMONIALS<\/p>","color_scheme":"scheme-1","use_custom_colors":false,"card_bg":"#f5f5f5","text_color":"#000000","star_color":"#000000","padding-block-start":64,"padding-block-end":64}},"editorial-trust-bar_2wc26s":{"type":"editorial-trust-bar","blocks":{"item_1":{"type":"trust_item","settings":{"heading":"<p>DIRECT ARTISAN PARTNERSHIPS<\/p>","description":"<p>We cut out the middlemen to ensure our embroiderers are paid fairly and you receive artisanal quality.<\/p>"}},"item_2":{"type":"trust_item","settings":{"heading":"<p>COORDINATED BLOUSE INCLUDED<\/p>","description":"<p>Every Anu saree comes with a matching unstitched blouse piece to eliminate sourcing stress.<\/p>"}},"item_3":{"type":"trust_item","settings":{"heading":"<p>DESIGNED FOR MOVEMENT<\/p>","description":"<p>Engineered with a specific fabric weight to ensure 8-hour wearability from day to night.<\/p>"}}},"block_order":["item_1","item_2","item_3"],"settings":{"color_scheme":"scheme-1","border_color":"#d4d4d4","divider_vertical_inset":14,"padding-block-start":64,"padding-block-end":64}},"editorial-accordion_a3ldfb":{"type":"editorial-accordion","blocks":{"item_0":{"type":"accordion_item","settings":{"heading":"<p>The Fabric &amp; Feel<\/p>","content":"<p>The Anu is crafted from a curated blend of silk and cotton, offering the sheen of heritage silk with the breathable, lightweight comfort of cotton. It is designed to be worn all day without fatigue.<\/p>"}},"item_1":{"type":"accordion_item","settings":{"heading":"<p>The Embroidery Process<\/p>","content":"<p>Each motif on the Anu saree is hand-threaded by our master artisans. Unlike machine embroidery, these stitches have depth and character that change with the light.<\/p>"}},"item_2":{"type":"accordion_item","settings":{"heading":"<p>The Blouse Piece<\/p>","content":"<p>We include a 1-meter coordinated fabric piece. This ensures your look is cohesive and editorial, removing the need to search for a matching shade elsewhere.<\/p>"}},"item_3":{"type":"accordion_item","settings":{"heading":"<p>Modern Wearability<\/p>","content":"<p>The drape is engineered for the modern woman. Whether you are at a boardroom meeting or a gallery opening, the Anu stays in place and honors your heritage effortlessly.<\/p>"}}},"block_order":["item_0","item_1","item_2","item_3"],"settings":{"heading":"<p>THE ANU DETAILS<\/p>","color_scheme":"scheme-1","use_custom_colors":false,"bg_color":"transparent","text_color":"#000000","border_color":"#e5e5e5","padding-block-start":64,"padding-block-end":64}},"featured-product-grid-v2_db4urx":{"type":"featured-product-grid-v2","settings":{"heading":"<p>The Anu Collection<\/p>","product_list":["anu"],"products_to_show":2,"desktop_width_percent":100,"columns_desktop":2,"columns_tablet":3,"columns_mobile":"2","section_padding":40,"heading_alignment":"center","heading_size":32,"heading_color":"#1a1815","heading_spacing":32,"card_background":"#ffffff","card_padding":16,"show_card_border":true,"card_border_width":1,"card_border_color":"#e0e0e0","show_card_shadow":false,"image_ratio":100,"product_title_size":16,"product_title_color":"#1a1815","show_price":true,"price_size":14,"price_color":"#1a1815","sale_price_color":"#2d1b4e","show_badges":true,"sale_badge_text":"Sale","sold_out_badge_text":"Sold out","badge_background":"#2d1b4e","badge_text_color":"#ffffff","badge_border_radius":4}}},"order":["product-main_je2bhx","editorial-used-by_vs4t8a","editorial-testimonials_kragxh","editorial-trust-bar_2wc26s","editorial-accordion_a3ldfb","featured-product-grid-v2_db4urx"]}