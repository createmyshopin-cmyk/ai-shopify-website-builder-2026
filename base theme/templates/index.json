7{"sections":{"editorial-hero_z43wjt":{"type":"editorial-hero","settings":{"image":"shopify:\/\/shop_images\/forge-deploy-0-1779596261803.png","heading":"HERITAGE MADE FOR EVERY DAY","subheading":"Hand-embroidered pieces designed for the woman who wears her heritage daily. Each Anu saree arrives with a coordinated blouse - no separate sourcing, no guessing.","button_label":"Explore the Anu Collection","button_link":"shopify:\/\/collections\/all","color_scheme":"","use_custom_colors":true,"text_color":"#ffffff","button_bg":"#ffffff","button_text_color":"#000000","overlay_opacity":100,"min_height":560,"padding-block-start":0,"padding-block-end":0}},"editorial-marquee_xb5yd8":{"type":"editorial-marquee","settings":{"text":"<p>DIRECT ARTISAN PARTNERSHIPS - NO LUXURY MARKUPS - COORDINATED BLOUSE INCLUDED<\/p>","show_separator":true,"speed":30,"direction":"left","font_size":1.2,"padding_vertical":12,"marquee_color_type":"accent","color_scheme":"scheme-1","use_custom_colors":false,"bg_color":"#000000","text_color":"#ffffff","padding-block-start":0,"padding-block-end":0}},"brand-story_5qmeg9":{"type":"brand-story","settings":{"max_width":1200,"section_padding":60,"mobile_spacing":40,"headline":"Traditional Crafts, Contemporary Contexts","story_text":"<p>We believe a saree shouldn't require a special occasion to see the light of day. Our collection is an act of reclamation, bridging the gap between ancestral artistry and modern living. Each stitch is a conversation between the artisan and the wearer, resulting in a drape that feels as effortless as a favorite linen shirt. No more ceremonial drawers - just wearable history that speaks fluently in your everyday life.<\/p>","media_type":"image","image":"shopify:\/\/shop_images\/IMG-3538.jpg","video":"","media_border_radius":12,"benefit_1":"Hand-embroidered by named artisans","benefit_2":"Engineered for 8-hour comfort","benefit_3":"Inclusive coordinated blouse pieces","benefit_4":"Direct-to-consumer artisanal pricing","benefit_5":"","benefit_6":"","benefit_spacing":20,"check_size":20,"use_custom_colors":false,"background_color":"#faf9f7","text_color":"#2c2c2c","check_color":"#8b7355","heading_size":36,"body_size":16,"benefit_size":15,"text_spacing":20,"color_scheme":""}},"editorial-collection-grid_ijb4vw":{"type":"editorial-collection-grid","blocks":{"item_1":{"type":"collection_item","settings":{"collection":"","image":"shopify:\/\/shop_images\/forge-deploy-1-1779596262697.png","label":"HAND-EMBROIDERED"}},"item_2":{"type":"collection_item","settings":{"collection":"","image":"shopify:\/\/shop_images\/forge-deploy-2-1779596263623.png","label":"EVERYDAY DRAPES"}},"item_3":{"type":"collection_item","settings":{"collection":"","image":"shopify:\/\/shop_images\/forge-deploy-3-1779596264451.png","label":"ARTISAN BLOUSES"}},"item_4":{"type":"collection_item","settings":{"collection":"","image":"shopify:\/\/shop_images\/forge-deploy-4-1779596265066.png","label":"HERITAGE STAPLES"}}},"block_order":["item_1","item_2","item_3","item_4"],"settings":{"heading":"<p>THE CURATOR'S EDIT<\/p>","columns":"4","color_scheme":"scheme-1","padding-block-start":64,"padding-block-end":64}},"product-storytelling-v2_vrmxy1":{"type":"product-storytelling-v2","settings":{"color_scheme":"","desktop_width_percent":100,"section_padding":60,"circle_gap":30,"circle_background":"#f5f5f5","content_spacing":60,"headline":"The Anatomy of the Anu Saree","headline_size":36,"headline_spacing":25,"intro_text":"<p>The Anu isn't just a garment; it's a commitment to making ethnic wear an editorial staple in your life, designed for wearability without compromise.<\/p>","intro_size":16,"intro_spacing":45,"blocks_columns":"3","blocks_gap":30,"blocks_spacing":40,"block_padding":20,"block_1_title":"Artisan Fingerprints","block_1_text":"<p>Every pattern is hand-stitched by skilled artisans rather than anonymous factories, ensuring no two pieces are identical and preserving the soul of the craft.<\/p>","block_2_title":"Seamless Coordination","block_2_text":"<p>We eliminate the stress of sourcing fabrics. Every saree includes a perfectly matched blouse piece, ensuring proportions and colors are exactly as intended.<\/p>","block_3_title":"Gravity-Defying Drape","block_3_text":"<p>Selected for weight and breathability, our fabrics are engineered to stay in place and feel light from morning meetings to late-night dinners.<\/p>","block_title_size":14,"block_title_spacing":10,"block_text_size":13,"divider_width":1,"divider_color":"#e0e0e0","closing_text":"Tradition you can live in, curated for the modern woman who refuses to compartmentalize her culture.","closing_size":14,"use_custom_colors":false,"background_color":"#faf8f6","text_color":"#2c2c2c"}},"editorial-ugc-strip_rk8bp5":{"type":"editorial-ugc-strip","blocks":{"photo_1":{"type":"photo","settings":{"image":"shopify:\/\/shop_images\/forge-deploy-5-1779596265709.png"}},"photo_2":{"type":"photo","settings":{"image":"shopify:\/\/shop_images\/forge-deploy-6-1779596266320.png"}},"photo_3":{"type":"photo","settings":{"image":"shopify:\/\/shop_images\/forge-deploy-7-1779596266928.png"}},"photo_4":{"type":"photo","settings":{"image":"shopify:\/\/shop_images\/forge-deploy-8-1779596267720.png"}},"photo_5":{"type":"photo","settings":{"image":"shopify:\/\/shop_images\/forge-deploy-9-1779596268393.png"}},"photo_6":{"type":"photo","settings":{"image":"shopify:\/\/shop_images\/forge-deploy-10-1779596269205.png"}}},"block_order":["photo_1","photo_2","photo_3","photo_4","photo_5","photo_6"],"settings":{"heading":"<p>Worn by You @NaariArdraknair<\/p>","heading_alignment":"center","heading_margin_bottom":24,"slide_width_desktop":360,"slide_width_mobile":280,"aspect_ratio":"1 \/ 1","gap":6,"full_width_strip":true,"scroll_snap":true,"enable_hover_zoom":true,"color_scheme":"scheme-1","padding-block-start":64,"padding-block-end":64}},"editorial-testimonials_2jirte":{"type":"editorial-testimonials","blocks":{"item_0":{"type":"review","settings":{"stars":5,"title":"<p>Not a Costume<\/p>","quote":"<p>I wore my Anu to a dinner party, not a wedding. It felt like part of my actual wardrobe, not a separate universe. The embroidery is subtle yet stunning.<\/p>","author":"Priya M.","product_info":""}},"item_1":{"type":"review","settings":{"stars":5,"title":"<p>Effortless Elegance<\/p>","quote":"<p>The fabric weight is perfect. I didn't feel the need to adjust it once during a 6-hour event. It truly feels like wearable art.<\/p>","author":"Anjali S.","product_info":""}},"item_2":{"type":"review","settings":{"stars":5,"title":"<p>Heritage Reclaimed<\/p>","quote":"<p>Finally, a saree that doesn't feel like I'm performing. It honors my roots while fitting my modern lifestyle perfectly.<\/p>","author":"Deepa K.","product_info":""}},"item_3":{"type":"review","settings":{"stars":5,"title":"<p>Beautiful Craft<\/p>","quote":"<p>The hand-embroidery is exquisite. You can tell it wasn't made in a factory. It has a soul you can't find elsewhere.<\/p>","author":"Meera R.","product_info":""}},"item_4":{"type":"review","settings":{"stars":5,"title":"<p>Perfect Pairing<\/p>","quote":"<p>Having the blouse piece included saved me so much time. The proportions were exactly right and the quality is exceptional.<\/p>","author":"Sanya L.","product_info":""}},"item_5":{"type":"review","settings":{"stars":5,"title":"<p>Modern Heirloom<\/p>","quote":"<p>A piece I will keep forever, but also one I will wear tomorrow. That is the magic of Ardraknair's design philosophy.<\/p>","author":"Kavita J.","product_info":""}}},"block_order":["item_0","item_1","item_2","item_3","item_4","item_5"],"settings":{"heading":"<p>WEARER PERSPECTIVES<\/p>","color_scheme":"scheme-1","use_custom_colors":false,"card_bg":"#f5f5f5","text_color":"#000000","star_color":"#000000","padding-block-start":64,"padding-block-end":64}},"editorial-trust-bar_uh15rq":{"type":"editorial-trust-bar","blocks":{"item_1":{"type":"trust_item","settings":{"icon":"","heading":"<p>ARTISAN DIRECT PRICING<\/p>","descr