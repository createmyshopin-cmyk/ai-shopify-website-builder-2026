{%- liquid
  assign contact_blocks = section.blocks | where: 'type', 'contact_item'
  assign padding_top_mobile = section.settings.padding-block-start-mobile | default: section.settings.padding-block-start | default: 32
  assign padding_bottom_mobile = section.settings.padding-block-end-mobile | default: section.settings.padding-block-end | default: 32

  assign raw_whatsapp = section.settings.whatsapp_number | default: '' | strip
  assign whatsapp_digits = raw_whatsapp | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', ''
  if whatsapp_digits contains '+'
    assign whatsapp_digits = whatsapp_digits | remove: '+'
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --neeloss-help-bg: {{ section.settings.card_background }};
    --neeloss-help-border: {{ section.settings.card_border_color }};
    --neeloss-help-radius: {{ section.settings.card_border_radius }}px;
    --neeloss-help-heading-color: {{ section.settings.heading_color }};
    --neeloss-help-subtext-color: {{ section.settings.subtext_color }};
    --neeloss-help-icon-color: {{ section.settings.contact_icon_color }};
    --neeloss-help-title-color: {{ section.settings.contact_title_color }};
    --neeloss-help-detail-color: {{ section.settings.contact_detail_color }};
    --neeloss-help-leaf-color: {{ section.settings.leaf_color }};
    --neeloss-help-heading-size: {{ section.settings.heading_font_size | default: 26 }}px;
    --neeloss-help-subheading-size: {{ section.settings.subheading_font_size | default: 22 }}px;
    --neeloss-help-contact-title-size: {{ section.settings.contact_title_font_size | default: 15 }}px;
    --neeloss-help-contact-detail-size: {{ section.settings.contact_detail_font_size | default: 13 }}px;
    --neeloss-help-mascot-size: {{ section.settings.mascot_size | default: 88 }}px;
    --neeloss-help-contact-icon-size: {{ section.settings.contact_icon_size | default: 36 }}px;
    --neeloss-help-card-padding: {{ section.settings.card_padding | default: 28 }}px;
    --neeloss-help-divider-inset: {{ section.settings.divider_inset | default: 16 }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --neeloss-help-heading-size: {{ section.settings.heading_font_size_mobile | default: 22 }}px;
      --neeloss-help-subheading-size: {{ section.settings.subheading_font_size_mobile | default: 18 }}px;
      --neeloss-help-contact-title-size: {{ section.settings.contact_title_font_size_mobile | default: 14 }}px;
      --neeloss-help-contact-detail-size: {{ section.settings.contact_detail_font_size_mobile | default: 12 }}px;
      --neeloss-help-mascot-size: {{ section.settings.mascot_size_mobile | default: 72 }}px;
      --neeloss-help-contact-icon-size: {{ section.settings.contact_icon_size_mobile | default: 32 }}px;
      --neeloss-help-card-padding: {{ section.settings.card_padding_mobile | default: 20 }}px;
    }

    #shopify-section-{{ section.id }} .neeloss-help.spacing-style {
      padding-bottom: var(--padding-block-end-mobile, var(--padding-block-end)) !important;
      padding-top: var(--padding-block-start-mobile, var(--padding-block-start)) !important;
    }
  }

  #shopify-section-{{ section.id }} .neeloss-help__heading {
    font-size: var(--neeloss-help-heading-size) !important;
  }

  #shopify-section-{{ section.id }} .neeloss-help__subheading {
    font-size: var(--neeloss-help-subheading-size) !important;
  }

  #shopify-section-{{ section.id }} .neeloss-help__contact-title {
    font-size: var(--neeloss-help-contact-title-size) !important;
  }

  #shopify-section-{{ section.id }} .neeloss-help__contact-detail {
    font-size: var(--neeloss-help-contact-detail-size) !important;
  }
{% endstyle %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    neeloss-help
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %} --padding-block-start-mobile: {{ padding_top_mobile }}px; --padding-block-end-mobile: {{ padding_bottom_mobile }}px;"
  {{ section.shopify_attributes }}
>
  <div class="neeloss-help__inner">
    <div class="neeloss-help__card">
      <div class="neeloss-help__layout">
        <div class="neeloss-help__brand">
          {% if section.settings.mascot_image != blank %}
            <span class="neeloss-help__mascot" aria-hidden="true">
              {{
                section.settings.mascot_image
                | image_url: width: 200
                | image_tag: class: 'neeloss-help__mascot-img', loading: 'lazy', alt: ''
              }}
            </span>
          {% endif %}

          <div class="neeloss-help__copy">
            {% if section.settings.heading != blank %}
              <p class="neeloss-help__heading">{{ section.settings.heading }}</p>
            {% endif %}
            {% if section.settings.subheading != blank %}
              <p class="neeloss-help__subheading">{{ section.settings.subheading }}</p>
            {% endif %}
          </div>
        </div>

        <div class="neeloss-help__contacts" role="list">
          {% if contact_blocks.size > 0 %}
            {% for block in contact_blocks %}
              {%- liquid
                assign item_url = block.settings.link | default: '' | strip
                assign item_icon = block.settings.icon | default: 'whatsapp'

                if item_url == blank
                  case item_icon
                    when 'whatsapp'
                      if whatsapp_digits != blank
                        assign item_url = 'https://wa.me/' | append: whatsapp_digits
                      endif
                    when 'phone'
                      assign phone_raw = block.settings.detail | default: '' | strip
                      assign phone_digits = phone_raw | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', ''
                      if phone_digits contains '+'
                        assign phone_digits = phone_digits | remove: '+'
                      endif
                      if phone_digits != blank
                        assign item_url = 'tel:+' | append: phone_digits
                      endif
                    when 'email'
                      assign email_raw = block.settings.detail | default: '' | strip
                      if email_raw != blank
                        assign item_url = 'mailto:' | append: email_raw
                      endif
                  endcase
                endif
              -%}

              <div class="neeloss-help__contact" role="listitem" {{ block.shopify_attributes }}>
                {% if item_url != blank %}
                  <a class="neeloss-help__contact-link" href="{{ item_url }}"{% if item_icon == 'whatsapp' %} target="_blank" rel="noopener noreferrer"{% endif %}>
                {% else %}
                  <div class="neeloss-help__contact-link">
                {% endif %}
                  <span class="neeloss-help__contact-icon" aria-hidden="true">
                    {% if block.settings.custom_icon != blank %}
                      {{
                        block.settings.custom_icon
                        | image_url: width: 72
                        | image_tag: class: 'neeloss-help__contact-icon-img', loading: 'lazy', alt: ''
                      }}
                    {% else %}
                      {% case item_icon %}
                        {% when 'phone' %}
                          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16 10h6l2 6-3.5 2.5c1.2 2.4 3.1 4.3 5.5 5.5L28 20l6 2v6c0 1.1-.9 2-2 2.2-11.2 1.2-20.4-8-19.2-19.2C13 10.9 14 10 16 10z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                          </svg>
                        {% when 'email' %}
                          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="9" y="13" width="30" height="22" rx="2" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M9 16l15 11 15-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {% else %}
                          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M24 8c-7.2 0-13 5.4-13 12.1 0 2.4.7 4.6 2 6.5L11 36l9.4-2.5c2 .9 4.2 1.4 6.6 1.4 7.2 0 13-5.4 13-12.1S31.2 8 24 8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                            <path d="M18 21.5c.5 2.2 2.6 4.8 5.2 6.1 1.1.5 2.3.8 3.5.8.6 0 1.1-.1 1.6-.2l2.2 1.2 1.2-2.2c.1-.5.2-1 .2-1.6 0-1.2-.3-2.4-.8-3.5-1.3-2.6-3.9-4.7-6.1-5.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                      {% endcase %}
                    {% endif %}
                  </span>
                  {% if block.settings.title != blank %}
                    <p class="neeloss-help__contact-title">{{ block.settings.title }}</p>
                  {% endif %}
                  {% if block.settings.detail != blank %}
                    <p class="neeloss-help__contact-detail">{{ block.settings.detail }}</p>
                  {% endif %}
                {% if item_url != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            {% assign default_titles = 'WhatsApp Us|Call Us|Email Us' | split: '|' %}
            {% assign default_details = 'Quick support|+91 799 444 1234|hello@neeloos.com' | split: '|' %}
            {% assign default_icons = 'whatsapp|phone|email' | split: '|' %}
            {% for i in (0..2) %}
              {%- liquid
                assign item_icon = default_icons[i]
                assign item_url = ''

                case item_icon
                  when 'whatsapp'
                    if whatsapp_digits != blank
                      assign item_url = 'https://wa.me/' | append: whatsapp_digits
                    endif
                  when 'phone'
                    assign item_url = 'tel:+917994441234'
                  when 'email'
                    assign item_url = 'mailto:hello@neeloos.com'
                endcase
              -%}
              <div class="neeloss-help__contact" role="listitem">
                <a class="neeloss-help__contact-link" href="{{ item_url }}"{% if item_icon == 'whatsapp' %} target="_blank" rel="noopener noreferrer"{% endif %}>
                  <span class="neeloss-help__contact-icon" aria-hidden="true">
                    {% case item_icon %}
                      {% when 'phone' %}
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M16 10h6l2 6-3.5 2.5c1.2 2.4 3.1 4.3 5.5 5.5L28 20l6 2v6c0 1.1-.9 2-2 2.2-11.2 1.2-20.4-8-19.2-19.2C13 10.9 14 10 16 10z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        </svg>
                      {% when 'email' %}
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <rect x="9" y="13" width="30" height="22" rx="2" stroke="currentColor" stroke-width="1.5"/>
                          <path d="M9 16l15 11 15-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {% else %}
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M24 8c-7.2 0-13 5.4-13 12.1 0 2.4.7 4.6 2 6.5L11 36l9.4-2.5c2 .9 4.2 1.4 6.6 1.4 7.2 0 13-5.4 13-12.1S31.2 8 24 8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                          <path d="M18 21.5c.5 2.2 2.6 4.8 5.2 6.1 1.1.5 2.3.8 3.5.8.6 0 1.1-.1 1.6-.2l2.2 1.2 1.2-2.2c.1-.5.2-1 .2-1.6 0-1.2-.3-2.4-.8-3.5-1.3-2.6-3.9-4.7-6.1-5.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    {% endcase %}
                  </span>
                  <p class="neeloss-help__contact-title">{{ default_titles[i] }}</p>
                  <p class="neeloss-help__contact-detail">{{ default_details[i] }}</p>
                </a>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        {% if section.settings.show_leaf_decoration %}
          <span class="neeloss-help__leaf" aria-hidden="true">
            {% if section.settings.leaf_image != blank %}
              {{
                section.settings.leaf_image
                | image_url: width: 160
                | image_tag: class: 'neeloss-help__leaf-img', loading: 'lazy', alt: ''
              }}
            {% else %}
              <svg viewBox="0 0 80 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M40 110V45" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M40 78C28 72 18 58 14 40" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M40 62C52 56 62 42 66 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M40 50C34 38 32 24 34 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M22 52c8 4 16 10 24 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M58 44c-8 4-16 10-24 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="18" cy="38" r="2.5" fill="currentColor" opacity="0.45"/>
                <circle cx="62" cy="26" r="2.5" fill="currentColor" opacity="0.45"/>
                <circle cx="36" cy="12" r="2" fill="currentColor" opacity="0.35"/>
              </svg>
            {% endif %}
          </span>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .neeloss-help__inner {
    margin: 0 auto;
    max-width: 1280px;
    width: 100%;
  }

  .neeloss-help__card {
    background: var(--neeloss-help-bg);
    border: 1px solid var(--neeloss-help-border);
    border-radius: var(--neeloss-help-radius);
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .neeloss-help__layout {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    gap: 28px;
    padding: var(--neeloss-help-card-padding);
    position: relative;
  }

  .neeloss-help__brand {
    align-items: center;
    display: flex;
    flex: 0 1 auto;
    gap: 16px;
    min-width: 0;
  }

  .neeloss-help__mascot {
    flex-shrink: 0;
    height: var(--neeloss-help-mascot-size);
    width: var(--neeloss-help-mascot-size);
  }

  .neeloss-help__mascot-img {
    display: block;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .neeloss-help__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .neeloss-help__heading,
  .neeloss-help__subheading {
    color: var(--neeloss-help-heading-color);
    font-family: var(--font-heading--family, Georgia, serif);
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
  }

  .neeloss-help__subheading {
    color: var(--neeloss-help-subtext-color);
    font-size: var(--neeloss-help-subheading-size);
  }

  .neeloss-help__contacts {
    display: grid;
    flex: 1 1 auto;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    min-width: 0;
  }

  .neeloss-help__contact {
    position: relative;
    text-align: center;
  }

  .neeloss-help__contact:not(:first-child)::before {
    background: var(--neeloss-help-border);
    bottom: var(--neeloss-help-divider-inset);
    content: '';
    left: 0;
    position: absolute;
    top: var(--neeloss-help-divider-inset);
    width: 1px;
  }

  .neeloss-help__contact-link {
    align-items: center;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px 12px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  a.neeloss-help__contact-link:hover {
    opacity: 0.8;
  }

  .neeloss-help__contact-icon {
    color: var(--neeloss-help-icon-color);
    height: var(--neeloss-help-contact-icon-size);
    width: var(--neeloss-help-contact-icon-size);
  }

  .neeloss-help__contact-icon svg,
  .neeloss-help__contact-icon-img {
    display: block;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .neeloss-help__contact-title {
    color: var(--neeloss-help-title-color);
    font-family: var(--font-body--family, inherit);
    font-size: var(--neeloss-help-contact-title-size);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .neeloss-help__contact-detail {
    color: var(--neeloss-help-detail-color);
    font-family: var(--font-body--family, inherit);
    font-size: var(--neeloss-help-contact-detail-size);
    font-weight: 400;
    line-height: 1.35;
    margin: 0;
  }

  .neeloss-help__leaf {
    bottom: 0;
    color: var(--neeloss-help-leaf-color);
    flex-shrink: 0;
    height: 96px;
    opacity: 0.7;
    pointer-events: none;
    position: absolute;
    right: 0;
    width: 64px;
  }

  .neeloss-help__leaf svg,
  .neeloss-help__leaf-img {
    display: block;
    height: 100%;
    object-fit: contain;
    object-position: bottom right;
    width: 100%;
  }

  @media screen and (max-width: 989px) {
    .neeloss-help__layout {
      align-items: stretch;
      flex-direction: column;
      gap: 20px;
    }

    .neeloss-help__brand {
      justify-content: center;
      text-align: center;
    }

    .neeloss-help__contacts {
      width: 100%;
    }

    .neeloss-help__leaf {
      height: 72px;
      opacity: 0.4;
      width: 48px;
    }
  }

  @media screen and (max-width: 749px) {
    .neeloss-help {
      box-sizing: border-box;
      max-width: 100%;
      overflow-x: clip;
      width: 100%;
    }

    .neeloss-help__inner {
      max-width: 100%;
      padding-inline: var(--page-margin, 16px);
    }

    .neeloss-help__brand {
      flex-direction: column;
      gap: 12px;
    }

    .neeloss-help__contacts {
      grid-template-columns: 1fr;
    }

    .neeloss-help__contact:not(:first-child)::before {
      display: none;
    }

    .neeloss-help__contact:not(:first-child) {
      border-top: 1px solid var(--neeloss-help-border);
    }

    .neeloss-help__contact-link {
      padding: 16px 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Neeloss Help",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "mascot_image",
      "label": "Mascot image",
      "info": "Upload the elephant mascot illustration."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Have Questions?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We're here for you, always."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "info": "Country code without +. Used for WhatsApp contact links. Example: 917994441234",
      "default": "917994441234"
    },
    {
      "type": "checkbox",
      "id": "show_leaf_decoration",
      "label": "Show leaf decoration",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "leaf_image",
      "label": "Custom leaf decoration",
      "info": "Optional. Replaces the default SVG branch."
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#fff9f0"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border & divider color",
      "default": "#e8e2d8"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_padding_mobile",
      "label": "Card padding (mobile)",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "divider_inset",
      "label": "Divider inset",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2b211b"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subheading color",
      "default": "#2b211b"
    },
    {
      "type": "color",
      "id": "contact_icon_color",
      "label": "Contact icon color",
      "default": "#6b8f4e"
    },
    {
      "type": "color",
      "id": "contact_title_color",
      "label": "Contact title color",
      "default": "#4a6741"
    },
    {
      "type": "color",
      "id": "contact_detail_color",
      "label": "Contact detail color",
      "default": "#8aab6e"
    },
    {
      "type": "color",
      "id": "leaf_color",
      "label": "Leaf decoration color",
      "default": "#c4a574"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 18,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "label": "Subheading size (mobile)",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
