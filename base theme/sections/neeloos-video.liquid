{% javascript %}
  class NeeloosVideoCarousel extends HTMLElement {
    constructor() {
      super();
      this.activeIndex = 0;
      this.isUserPaused = false;
      this.isCarouselSuspended = false;
      this.autoplayTimer = null;
      this.autoplayLoopId = 0;
      this.scrollAnimationId = null;
      this.scrollRaf = null;
      this.scrollingProgrammatically = false;
      this.autoplayEnabled = this.dataset.autoplay === 'true';
      this.autoplaySpeed = (parseInt(this.dataset.autoplaySpeed, 10) || 5) * 1000;
      this.slideDuration = parseInt(this.dataset.slideDuration, 10) || 700;
      this.mobileAspectMode = this.dataset.mobileAspect || 'auto';
      this.videoAutoplayEnabled = this.dataset.videoAutoplay === 'true';
      this.defaultMuted = this.dataset.videoMuted !== 'false';
      this.showMuteButton = this.dataset.showMuteButton !== 'false';
      this.videoLoop = this.dataset.videoLoop === 'true';
      this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    connectedCallback() {
      this.track = this.querySelector('[data-track]');
      this.dotsContainer = this.querySelector('[data-dots]');
      this.cards = Array.from(this.track?.querySelectorAll('.neeloos-video__card') || []);

      if (!this.track || this.cards.length === 0) return;

      this.activeIndex = this.getIndexFromScroll();
      this.readSettings();

      this.initInlinePlayers();
      this.initVideoAutoplayObserver();
      this.initModal();
      this.bindEvents();
      this.refresh();

      requestAnimationFrame(() => {
        requestAnimationFrame(() => this.refresh());
      });

      this.resizeObserver = new ResizeObserver(() => {
        window.clearTimeout(this._refreshDebounce);
        this._refreshDebounce = window.setTimeout(() => this.refresh(), 200);
      });
      this.resizeObserver.observe(this);

      this.reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      this._handleReducedMotionChange = () => {
        this.prefersReducedMotion = this.reducedMotionQuery.matches;
        this.refresh();
      };
      this.reducedMotionQuery.addEventListener('change', this._handleReducedMotionChange);

      this._handleResize = () => {
        window.clearTimeout(this._resizeDebounce);
        this._resizeDebounce = window.setTimeout(() => this.refresh(), 150);
      };
      window.addEventListener('resize', this._handleResize);
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
      this.videoObserver?.disconnect();
      this.stopAutoplay();
      this.cancelScrollAnimation();
      window.clearTimeout(this._refreshDebounce);
      window.clearTimeout(this._resizeDebounce);
      if (this._resumeTimer) clearTimeout(this._resumeTimer);
      this.reducedMotionQuery?.removeEventListener('change', this._handleReducedMotionChange);
      window.removeEventListener('resize', this._handleResize);
    }

    readSettings() {
      this.autoplayEnabled = this.dataset.autoplay === 'true';
      this.autoplaySpeed = (parseInt(this.dataset.autoplaySpeed, 10) || 5) * 1000;
      this.slideDuration = parseInt(this.dataset.slideDuration, 10) || 700;
      this.mobileAspectMode = this.dataset.mobileAspect || 'auto';
      this.videoAutoplayEnabled = this.dataset.videoAutoplay === 'true';
      this.defaultMuted = this.dataset.videoMuted !== 'false';
      this.showMuteButton = this.dataset.showMuteButton !== 'false';
      this.videoLoop = this.dataset.videoLoop === 'true';
      this.desktopPopupEnabled = this.dataset.desktopPopup === 'true';
      this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    isDesktopViewport() {
      return window.innerWidth >= 750;
    }

    useDesktopPopup() {
      return this.desktopPopupEnabled && this.isDesktopViewport();
    }

    isMobileCarousel() {
      return window.innerWidth <= 749 && this.dataset.mobileLayout === 'row-scroll';
    }

    shouldDisableVideoAutoplayOnMobile() {
      return this.isMobileCarousel() && this.autoplayEnabled;
    }

    refresh() {
      this.readSettings();
      this.cards = Array.from(this.track?.querySelectorAll('.neeloos-video__card') || []);

      if (!this.isMobileCarousel()) {
        this.dotsContainer.innerHTML = '';
        this.stopAutoplay();
        return;
      }

      this.activeIndex = this.getIndexFromScroll();
      this.createDots();
      this.updateDots();

      if (!this.hasPlayingVideo()) {
        this.isCarouselSuspended = false;
      }

      if (!this.isUserPaused && !this.isCarouselSuspended) {
        this.startAutoplay();
      }
    }

    easeInOutCubic(progress) {
      return progress < 0.5
        ? 4 * progress * progress * progress
        : 1 - Math.pow(-2 * progress + 2, 3) / 2;
    }

    getCardScrollLeft(index) {
      const card = this.cards[index];
      if (!card || !this.track) return 0;

      const trackWidth = this.track.clientWidth;
      const cardWidth = card.offsetWidth;
      const maxScroll = Math.max(0, this.track.scrollWidth - trackWidth);
      const cardStart = card.offsetLeft;
      const centered = cardStart - (trackWidth - cardWidth) / 2;

      return Math.min(maxScroll, Math.max(0, centered));
    }

    cancelScrollAnimation() {
      if (this.scrollAnimationId) {
        cancelAnimationFrame(this.scrollAnimationId);
        this.scrollAnimationId = null;
      }
      this.track?.classList.remove('is-scrolling');
      this.scrollingProgrammatically = false;
    }

    animateScrollTo(targetLeft, duration = this.slideDuration) {
      if (!this.track) return Promise.resolve();

      this.cancelScrollAnimation();

      if (this.prefersReducedMotion || duration <= 0) {
        this.track.scrollLeft = targetLeft;
        this.scrollingProgrammatically = false;
        return Promise.resolve();
      }

      const startLeft = this.track.scrollLeft;
      const distance = targetLeft - startLeft;

      if (Math.abs(distance) < 1) {
        this.track.scrollLeft = targetLeft;
        return Promise.resolve();
      }

      this.scrollingProgrammatically = true;
      this.track.classList.add('is-scrolling');
      const startTime = performance.now();

      return new Promise((resolve) => {
        const step = (now) => {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          this.track.scrollLeft = startLeft + distance * this.easeInOutCubic(progress);

          if (progress < 1) {
            this.scrollAnimationId = requestAnimationFrame(step);
            return;
          }

          this.track.scrollLeft = targetLeft;
          this.scrollAnimationId = null;
          this.track.classList.remove('is-scrolling');
          this.scrollingProgrammatically = false;
          resolve();
        };

        this.scrollAnimationId = requestAnimationFrame(step);
      });
    }

    createDots() {
      if (!this.dotsContainer) return;

      this.dotsContainer.innerHTML = '';

      this.cards.forEach((_, index) => {
        const dot = document.createElement('button');
        dot.className = 'neeloos-video__dot';
        dot.type = 'button';
        dot.setAttribute('role', 'tab');
        dot.dataset.dotIndex = String(index);
        dot.setAttribute('aria-label', `Go to video ${index + 1}`);
        dot.setAttribute('aria-selected', index === this.activeIndex ? 'true' : 'false');
        dot.addEventListener('click', () => this.scrollToIndex(index));
        this.dotsContainer.appendChild(dot);
      });
    }

    bindEvents() {
      this.track.addEventListener(
        'scroll',
        () => {
          if (this.scrollingProgrammatically) return;
          cancelAnimationFrame(this.scrollRaf);
          this.scrollRaf = requestAnimationFrame(() => {
            this.activeIndex = this.getIndexFromScroll();
            this.updateDots();
          });
        },
        { passive: true }
      );

      let dragStartX = null;
      let dragPaused = false;

      const resetDrag = () => {
        dragStartX = null;
        dragPaused = false;
      };

      this.track.addEventListener('pointerdown', (event) => {
        if (event.target.closest('[data-play-button], [data-mute-button]')) return;
        dragStartX = event.clientX;
        dragPaused = false;
      });

      this.track.addEventListener(
        'pointermove',
        (event) => {
          if (dragStartX === null || dragPaused) return;
          if (Math.abs(event.clientX - dragStartX) > 12) {
            dragPaused = true;
            this.pauseCarouselForUser();
          }
        },
        { passive: true }
      );

      this.track.addEventListener('pointerup', () => {
        if (dragPaused) this.scheduleUserResume();
        resetDrag();
      });
      this.track.addEventListener('pointercancel', resetDrag);
      this.track.addEventListener('lostpointercapture', resetDrag);
    }

    getIndexFromScroll() {
      if (!this.track || this.cards.length === 0) return 0;

      const scrollLeft = this.track.scrollLeft;
      let closestIndex = 0;
      let closestDistance = Infinity;

      this.cards.forEach((card, index) => {
        const distance = Math.abs(this.getCardScrollLeft(index) - scrollLeft);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    }

    async scrollToIndex(index, duration = this.slideDuration, options = {}) {
      const { fromAutoplay = false } = options;
      const card = this.cards[index];
      if (!card || !this.track) return;

      const previousIndex = this.activeIndex;
      const targetLeft = this.getCardScrollLeft(index);
      const isWrap =
        index === 0 &&
        previousIndex === this.cards.length - 1 &&
        previousIndex !== index;

      this.activeIndex = index;
      this.updateDots();

      if (isWrap) {
        this.cancelScrollAnimation();
        this.track.scrollLeft = targetLeft;
        return;
      }

      await this.animateScrollTo(targetLeft, duration);
      this.activeIndex = this.getIndexFromScroll();
      this.updateDots();

      if (!fromAutoplay) {
        window.setTimeout(() => {
          if (!this.hasPlayingVideo()) {
            this.resumeCarouselAutoplay();
          }
        }, 150);
      }
    }

    updateDots() {
      this.dotsContainer?.querySelectorAll('.neeloos-video__dot').forEach((dot, index) => {
        dot.setAttribute('aria-selected', index === this.activeIndex ? 'true' : 'false');
      });
    }

    waitAutoplayDelay(ms, loopId) {
      return new Promise((resolve) => {
        this._delayResolve = (completed) => {
          this._delayResolve = null;
          resolve(completed && loopId === this.autoplayLoopId);
        };
        this.autoplayTimer = window.setTimeout(() => {
          this.autoplayTimer = null;
          this._delayResolve?.(true);
        }, ms);
      });
    }

    cancelAutoplayDelay() {
      if (this.autoplayTimer) {
        clearTimeout(this.autoplayTimer);
        this.autoplayTimer = null;
      }
      this._delayResolve?.(false);
    }

    pauseAllVideosForCarousel() {
      this.mediaItems?.forEach((item) => {
        const thumb = item.querySelector('.neeloos-video__thumb');
        const video = item.querySelector('video');
        const muteButton = item.querySelector('[data-mute-button]');
        const embedFrame = item.querySelector('.neeloos-video__player--embed');
        const durationEl = item.querySelector('[data-duration]');

        this.setVideoPlayingState(thumb, muteButton, video, false);

        if (video && !video.paused) {
          video.pause();
          if (durationEl && Number.isFinite(video.duration)) {
            durationEl.textContent = this.formatTime(video.duration);
          }
        }

        if (embedFrame?.src) {
          embedFrame.src = '';
          item.querySelector('[data-embed-wrap]')?.setAttribute('hidden', '');
        }
      });
    }

    startAutoplay() {
      this.stopAutoplay();
      if (!this.autoplayEnabled || !this.isMobileCarousel()) return;
      if (this.isUserPaused || this.isCarouselSuspended) return;
      if (this.cards.length < 2) return;

      const loopId = ++this.autoplayLoopId;

      const runAutoplay = async () => {
        while (
          loopId === this.autoplayLoopId &&
          this.autoplayEnabled &&
          this.isMobileCarousel() &&
          !this.isUserPaused &&
          !this.isCarouselSuspended
        ) {
          const holdTime = Math.max(1200, this.autoplaySpeed - this.slideDuration);
          const delayOk = await this.waitAutoplayDelay(holdTime, loopId);
          if (!delayOk) break;

          if (
            loopId !== this.autoplayLoopId ||
            this.isUserPaused ||
            this.isCarouselSuspended ||
            !this.isMobileCarousel()
          ) {
            break;
          }

          this._carouselAdvancing = true;
          this.isCarouselSuspended = false;
          this.pauseAllVideosForCarousel();

          const nextIndex = (this.activeIndex + 1) % this.cards.length;
          await this.scrollToIndex(nextIndex, this.slideDuration, { fromAutoplay: true });
          this._carouselAdvancing = false;
        }
      };

      runAutoplay();
    }

    stopAutoplay() {
      this.autoplayLoopId += 1;
      this.cancelAutoplayDelay();
    }

    suspendCarouselAutoplay() {
      this.isCarouselSuspended = true;
      this.stopAutoplay();
    }

    resumeCarouselAutoplay() {
      this.isCarouselSuspended = false;
      if (!this.isUserPaused) {
        this.startAutoplay();
      }
    }

    pauseCarouselForUser() {
      this.isUserPaused = true;
      this.stopAutoplay();
      this.cancelScrollAnimation();
    }

    resumeCarouselForUser() {
      this.isUserPaused = false;
      this.startAutoplay();
    }

    scheduleUserResume() {
      if (this._resumeTimer) clearTimeout(this._resumeTimer);
      this._resumeTimer = window.setTimeout(() => this.resumeCarouselForUser(), 2500);
    }

    formatTime(seconds) {
      if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
      const total = Math.floor(seconds);
      const mins = Math.floor(total / 60);
      const secs = total % 60;
      return `${mins}:${String(secs).padStart(2, '0')}`;
    }

    applyMobileAspectRatio(thumb, card, video) {
      if (!thumb || window.innerWidth > 749) return;
      if (thumb.classList.contains('neeloos-video__thumb--ratio-9-16') || thumb.classList.contains('neeloos-video__thumb--ratio-4-3')) {
        return;
      }

      let ratio = '4-3';
      if (video && video.videoWidth && video.videoHeight) {
        ratio = video.videoHeight > video.videoWidth ? '9-16' : '4-3';
      } else if (this.mobileAspectMode === '9-16') {
        ratio = '9-16';
      }

      thumb.classList.remove('neeloos-video__thumb--ratio-auto');
      thumb.classList.add(`neeloos-video__thumb--ratio-${ratio}`);
      card?.classList.remove('neeloos-video__card--ratio-auto');
      card?.classList.add(`neeloos-video__card--ratio-${ratio}`);
    }

    updateMuteButton(muteButton, isMuted) {
      if (!muteButton) return;
      const mutedIcon = muteButton.querySelector('.neeloos-video__mute-icon--muted');
      const unmutedIcon = muteButton.querySelector('.neeloos-video__mute-icon--unmuted');

      muteButton.setAttribute('aria-pressed', isMuted ? 'true' : 'false');
      muteButton.setAttribute('aria-label', isMuted ? 'Unmute video' : 'Mute video');

      if (mutedIcon) mutedIcon.hidden = !isMuted;
      if (unmutedIcon) unmutedIcon.hidden = isMuted;
    }

    syncMuteButton(muteButton, video) {
      if (!muteButton || !video) return;
      this.updateMuteButton(muteButton, video.muted);
    }

    setVideoPlayingState(thumb, muteButton, video, isPlaying) {
      thumb?.classList.toggle('is-playing', isPlaying);
      if (this.showMuteButton && muteButton && video) {
        muteButton.hidden = !isPlaying;
      }
    }

    pauseOtherVideos(currentMedia) {
      this.mediaItems?.forEach((item) => {
        if (item === currentMedia) return;
        const otherThumb = item.querySelector('.neeloos-video__thumb');
        const otherVideo = item.querySelector('video');
        const otherFrame = item.querySelector('.neeloos-video__player--embed');
        const otherMute = item.querySelector('[data-mute-button]');
        this.setVideoPlayingState(otherThumb, otherMute, otherVideo, false);
        if (otherVideo) {
          otherVideo.pause();
          const otherDuration = item.querySelector('[data-duration]');
          if (otherDuration && Number.isFinite(otherVideo.duration)) {
            otherDuration.textContent = this.formatTime(otherVideo.duration);
          }
        }
        if (otherFrame) {
          otherFrame.src = '';
          item.querySelector('[data-embed-wrap]')?.setAttribute('hidden', '');
        }
      });

      if (!this.hasPlayingVideo()) {
        this.resumeCarouselAutoplay();
      }
    }

    hasPlayingVideo() {
      return (
        this.mediaItems?.some((item) => {
          const video = item.querySelector('video');
          return video && !video.paused && !video.ended;
        }) || false
      );
    }

    initVideoAutoplayObserver() {
      this.videoObserver?.disconnect();
      if (!this.videoAutoplayEnabled || this.prefersReducedMotion) return;

      this.videoObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const media = entry.target;
            const video = media.querySelector('video');
            const thumb = media.querySelector('.neeloos-video__thumb');
            const muteButton = media.querySelector('[data-mute-button]');
            if (!video) return;

            if (this.shouldDisableVideoAutoplayOnMobile()) return;

            if (entry.isIntersecting && entry.intersectionRatio >= 0.55) {
              if (this.useDesktopPopup()) return;

              this.pauseOtherVideos(media);
              this.suspendCarouselAutoplay();
              if (media.dataset.userUnmuted !== 'true') {
                video.muted = this.defaultMuted;
                this.updateMuteButton(muteButton, video.muted);
              }
              video.loop = this.videoLoop;
              this.setVideoPlayingState(thumb, muteButton, video, true);
              video.play().catch(() => {
                this.setVideoPlayingState(thumb, muteButton, video, false);
              });
            } else if (!video.paused) {
              video.pause();
              if (!video.ended) {
                this.setVideoPlayingState(thumb, muteButton, video, false);
              }
              this.resumeCarouselAutoplay();
            }
          });
        },
        { threshold: [0, 0.55, 0.85] }
      );

      this.mediaItems?.forEach((media) => {
        if (media.querySelector('video')) {
          this.videoObserver.observe(media);
        }
      });
    }

    initModal() {
      this.modal = this.querySelector('[data-neeloos-video-modal]');
      this.modalBody = this.querySelector('[data-neeloos-video-modal-body]');
      this.modalClose = this.querySelector('[data-neeloos-video-close]');
      if (!this.modal || !this.modalBody) return;

      this.modalClose?.addEventListener('click', () => this.closeVideoModal());
      this.modal.addEventListener('click', (event) => {
        if (event.target === this.modal) this.closeVideoModal();
      });
      this.modal.addEventListener('close', () => this.clearVideoModal());
    }

    clearVideoModal() {
      if (!this.modalBody) return;
      this.modalBody.querySelectorAll('video').forEach((video) => {
        video.pause();
        video.removeAttribute('src');
        video.load();
      });
      this.modalBody.innerHTML = '';
    }

    closeVideoModal() {
      if (!this.modal?.open) return;
      this.modal.close();
      this.clearVideoModal();
      this.resumeCarouselAutoplay();
    }

    openVideoModal(media) {
      if (!this.modal || !this.modalBody) return;

      const kind = media.dataset.videoKind;
      const card = media.closest('.neeloos-video__card');
      const caption = card?.querySelector('.neeloos-video__caption')?.textContent?.trim() || 'Video';
      const isUnmuted = media.dataset.userUnmuted === 'true';
      const shouldMute = !isUnmuted && this.defaultMuted;

      this.pauseOtherVideos(media);
      this.suspendCarouselAutoplay();
      this.clearVideoModal();

      if (kind === 'youtube' && media.dataset.youtubeId) {
        const iframe = document.createElement('iframe');
        iframe.className = 'neeloos-video__modal-player';
        iframe.src = `https://www.youtube.com/embed/${media.dataset.youtubeId}?autoplay=1&playsinline=1&rel=0&mute=${shouldMute ? '1' : '0'}`;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = caption;
        this.modalBody.appendChild(iframe);
      } else if (kind === 'vimeo' && media.dataset.vimeoId) {
        const iframe = document.createElement('iframe');
        iframe.className = 'neeloos-video__modal-player';
        iframe.src = `https://player.vimeo.com/video/${media.dataset.vimeoId}?autoplay=1&muted=${shouldMute ? '1' : '0'}`;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = caption;
        this.modalBody.appendChild(iframe);
      } else if (kind === 'shopify') {
        const template = card?.querySelector('[data-neeloos-video-template]');
        if (!template) return;
        const clone = template.content.cloneNode(true);
        const modalVideo = clone.querySelector('video');
        if (modalVideo) {
          modalVideo.muted = shouldMute;
          modalVideo.autoplay = true;
          modalVideo.controls = true;
        }
        this.modalBody.appendChild(clone);
      } else if (media.dataset.videoUrl) {
        const modalVideo = document.createElement('video');
        modalVideo.className = 'neeloos-video__modal-player';
        modalVideo.src = media.dataset.videoUrl;
        modalVideo.controls = true;
        modalVideo.autoplay = true;
        modalVideo.playsInline = true;
        modalVideo.muted = shouldMute;
        this.modalBody.appendChild(modalVideo);
      } else {
        const sourceVideo = media.querySelector('video');
        if (!sourceVideo) return;
        const modalVideo = document.createElement('video');
        modalVideo.className = 'neeloos-video__modal-player';
        modalVideo.controls = true;
        modalVideo.autoplay = true;
        modalVideo.playsInline = true;
        modalVideo.muted = shouldMute;
        sourceVideo.querySelectorAll('source').forEach((source) => {
          const clonedSource = document.createElement('source');
          clonedSource.src = source.src;
          clonedSource.type = source.type;
          modalVideo.appendChild(clonedSource);
        });
        if (sourceVideo.currentSrc) {
          modalVideo.src = sourceVideo.currentSrc;
        }
        this.modalBody.appendChild(modalVideo);
      }

      if (typeof this.modal.showModal === 'function') {
        this.modal.showModal();
      }
    }

    initInlinePlayers() {
      this.mediaItems = Array.from(this.querySelectorAll('[data-neeloos-video-media]'));

      this.mediaItems.forEach((media) => {
        if (media.dataset.inlineInit === 'true') return;
        media.dataset.inlineInit = 'true';

        const thumb = media.querySelector('.neeloos-video__thumb');
        const card = media.closest('.neeloos-video__card');
        const playButton = media.querySelector('[data-play-button]');
        const muteButton = media.querySelector('[data-mute-button]');
        const durationEl = media.querySelector('[data-duration]');
        const kind = media.dataset.videoKind;
        const video = media.querySelector('video.neeloos-video__player') || media.querySelector('video');
        const embedWrap = media.querySelector('[data-embed-wrap]');
        const embedFrame = media.querySelector('.neeloos-video__player--embed');

        if (video && media.dataset.posterUrl) {
          video.setAttribute('poster', media.dataset.posterUrl);
        }

        if (video) {
          video.muted = this.defaultMuted;
          video.loop = this.videoLoop;
          this.syncMuteButton(muteButton, video);

          video.addEventListener('volumechange', () => {
            this.syncMuteButton(muteButton, video);
          });
        }

        const showDuration = (seconds) => {
          if (!durationEl || !Number.isFinite(seconds)) return;
          durationEl.textContent = this.formatTime(seconds);
          durationEl.hidden = false;
        };

        const updateCountdown = () => {
          if (!video || !durationEl) return;
          const remaining = Math.max(0, video.duration - video.currentTime);
          durationEl.textContent = this.formatTime(remaining);
        };

        const pauseOthers = (currentMedia) => {
          this.pauseOtherVideos(currentMedia);
        };

        const startPlaying = () => {
          if (this.useDesktopPopup()) {
            this.openVideoModal(media);
            return;
          }

          pauseOthers(media);
          this.suspendCarouselAutoplay();
          if (video && media.dataset.userUnmuted !== 'true') {
            video.muted = this.defaultMuted;
            this.updateMuteButton(muteButton, video.muted);
          }
          this.setVideoPlayingState(thumb, muteButton, video, true);

          if (kind === 'youtube' && embedWrap && embedFrame && media.dataset.youtubeId) {
            embedWrap.removeAttribute('hidden');
            const muteParam = this.defaultMuted && media.dataset.userUnmuted !== 'true' ? '1' : '0';
            embedFrame.src = `https://www.youtube.com/embed/${media.dataset.youtubeId}?autoplay=1&playsinline=1&rel=0&mute=${muteParam}`;
            return;
          }

          if (kind === 'vimeo' && embedWrap && embedFrame && media.dataset.vimeoId) {
            embedWrap.removeAttribute('hidden');
            const muteParam = this.defaultMuted && media.dataset.userUnmuted !== 'true' ? '1' : '0';
            embedFrame.src = `https://player.vimeo.com/video/${media.dataset.vimeoId}?autoplay=1&muted=${muteParam}`;
            return;
          }

          if (video) {
            video.play().catch(() => {
              this.setVideoPlayingState(thumb, muteButton, video, false);
              this.resumeCarouselAutoplay();
            });
          }
        };

        if (video) {
          video.addEventListener('loadedmetadata', () => {
            this.applyMobileAspectRatio(thumb, card, video);
            showDuration(video.duration);
          });

          video.addEventListener('loadeddata', () => {
            this.applyMobileAspectRatio(thumb, card, video);
            if (!video.getAttribute('poster') && video.paused) {
              video.currentTime = Math.min(0.1, video.duration || 0.1);
            }
          });

          video.addEventListener('timeupdate', updateCountdown);

          video.addEventListener('play', () => {
            this.setVideoPlayingState(thumb, muteButton, video, true);
            if (!this._carouselAdvancing) {
              this.suspendCarouselAutoplay();
            }
            pauseOthers(media);
          });

          video.addEventListener('pause', () => {
            if (video.ended) return;
            this.setVideoPlayingState(thumb, muteButton, video, false);
            if (Number.isFinite(video.duration)) {
              showDuration(video.duration);
            }
            this.resumeCarouselAutoplay();
          });

          video.addEventListener('ended', () => {
            if (!this.videoLoop) {
              this.setVideoPlayingState(thumb, muteButton, video, false);
            }
            video.currentTime = 0;
            if (!video.getAttribute('poster') && Number.isFinite(video.duration)) {
              video.currentTime = Math.min(0.1, video.duration);
            }
            if (Number.isFinite(video.duration)) {
              showDuration(video.duration);
            }
            if (!this.videoLoop) {
              this.resumeCarouselAutoplay();
            }
          });

          if (video.readyState >= 1) {
            showDuration(video.duration);
          }
        }

        playButton?.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          startPlaying();
        });

        muteButton?.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          if (!video) return;

          const willBeMuted = !video.muted;
          video.muted = willBeMuted;

          if (willBeMuted) {
            delete media.dataset.userUnmuted;
          } else {
            media.dataset.userUnmuted = 'true';
          }

          this.syncMuteButton(muteButton, video);
        });

        thumb?.addEventListener('click', (event) => {
          if (event.target.closest('[data-play-button], [data-mute-button]')) return;

          if (this.useDesktopPopup()) {
            startPlaying();
            return;
          }

          if (kind === 'youtube' || kind === 'vimeo') return;
          if (video?.paused) {
            startPlaying();
          } else if (video) {
            video.pause();
          }
        });

        if ((kind === 'youtube' || kind === 'vimeo') && durationEl) {
          durationEl.hidden = true;
        }
      });
    }
  }

  if (!customElements.get('neeloos-video-carousel')) {
    customElements.define('neeloos-video-carousel', NeeloosVideoCarousel);
  }
