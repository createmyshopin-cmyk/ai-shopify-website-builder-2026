{% liquid
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign columns = section.settings.columns | default: 4
  assign mobile_layout = section.settings.mobile_layout | default: 'row-scroll'
  assign mobile_aspect_ratio = section.settings.mobile_aspect_ratio | default: 'auto'
  assign video_autoplay = section.settings.video_autoplay
  assign video_muted = section.settings.video_muted
  assign video_loop = section.settings.video_loop
  assign show_mute_button = section.settings.show_mute_button
  assign desktop_video_playback = section.settings.desktop_video_playback | default: 'popup'
  assign heading_font_size = section.settings.heading_font_size | default: 40
  assign heading_font_size_mobile = section.settings.heading_font_size_mobile | default: 28
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --neeloos-video-columns: {{ columns }};
    --neeloos-video-gap: {{ section.settings.gap }}px;
    --neeloos-video-heading-size: {{ heading_font_size }}px;
    --neeloos-video-leaf-color: {{ section.settings.leaf_color }};
    --neeloos-video-title-color: {{ section.settings.title_color }};
    --neeloos-video-link-color: {{ section.settings.link_color }};
    --neeloos-video-caption-color: {{ section.settings.caption_color }};
    --neeloos-video-thumb-radius: {{ section.settings.thumbnail_radius }}px;
    --neeloos-video-duration-bg: {{ section.settings.duration_bg }};
    --neeloos-video-duration-color: {{ section.settings.duration_color }};
    --neeloos-video-dot-active: {{ section.settings.dot_active_color }};
    --neeloos-video-dot-inactive: {{ section.settings.dot_inactive_color }};
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --neeloos-video-gap: {{ section.settings.mobile_gap }}px;
      --neeloos-video-heading-size: {{ heading_font_size_mobile }}px;
    }
  }

  #shopify-section-{{ section.id }} .neeloos-video__title,
  #shopify-section-{{ section.id }} h2.neeloos-video__title,
  #shopify-section-{{ section.id }} .neeloos-video__title:is(.h1.h1, .h2.h2, .h3.h3) {
    font-size: {{ heading_font_size }}px !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .neeloos-video__title,
    #shopify-section-{{ section.id }} h2.neeloos-video__title,
    #shopify-section-{{ section.id }} .neeloos-video__title:is(.h1.h1, .h2.h2, .h3.h3) {
      font-size: {{ heading_font_size_mobile }}px !important;
    }
  }
{% endstyle %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    neeloos-video
    neeloos-video--mobile-{{ mobile_layout }}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="neeloos-video__inner">
    {% if section.settings.show_heading %}
      <div class="neeloos-video__header">
        {% assign heading_type_preset = section.settings.heading_type_preset | default: 'h2' %}
        <h2 class="neeloos-video__title {{ heading_type_preset }} {{ heading_type_preset }}">
          <span>{{ section.settings.heading }}</span>
          {% if section.settings.show_leaf_icon %}
            <span class="neeloos-video__leaf" aria-hidden="true">
              <svg viewBox="0 0 42 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 19C10 19 5 13 3 5c8 0 15 3 18 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path d="M24 16C25 8 31 3 39 2c-1 8-6 14-15 16" fill="currentColor" opacity=".75"/>
                <path d="M7 12c9 2 18 7 27 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </span>
          {% endif %}
        </h2>

        {% if section.settings.link_label != blank %}
          <a
            href="{{ section.settings.link_url | default: '#' }}"
            class="neeloos-video__link"
          >
            <span>{{ section.settings.link_label }}</span>
            <span class="neeloos-video__link-arrow" aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if video_blocks.size > 0 %}
      <neeloos-video-carousel
        class="neeloos-video__carousel"
        data-mobile-layout="{{ mobile_layout }}"
        data-autoplay="{% if section.settings.mobile_autoplay %}true{% else %}false{% endif %}"
        data-autoplay-speed="{{ section.settings.mobile_autoplay_speed }}"
        data-slide-duration="{{ section.settings.mobile_slide_duration }}"
        data-mobile-aspect="{{ mobile_aspect_ratio }}"
        data-video-autoplay="{% if video_autoplay %}true{% else %}false{% endif %}"
        data-video-muted="{% if video_muted %}true{% else %}false{% endif %}"
        data-show-mute-button="{% if show_mute_button %}true{% else %}false{% endif %}"
        data-video-loop="{% if video_loop %}true{% else %}false{% endif %}"
        data-desktop-popup="{% if desktop_video_playback == 'popup' %}true{% else %}false{% endif %}"
      >
        <div class="neeloos-video__grid" data-track>
        {% for block in video_blocks %}
          {% liquid
            assign has_shopify_video = false
            assign has_external_video = false
            if block.settings.video != blank
              assign has_shopify_video = true
            elsif block.settings.video_url != blank
              assign has_external_video = true
            endif

            assign youtube_id = ''
            if block.settings.video_url != blank
              assign video_url = block.settings.video_url
              if video_url contains 'youtube.com/watch?v='
                assign youtube_id = video_url | split: 'v=' | last | split: '&' | first
              elsif video_url contains 'youtu.be/'
                assign youtube_id = video_url | split: 'youtu.be/' | last | split: '?' | first
              elsif video_url contains 'youtube.com/embed/'
                assign youtube_id = video_url | split: 'embed/' | last | split: '?' | first
              elsif video_url contains 'youtube.com/shorts/'
                assign youtube_id = video_url | split: 'shorts/' | last | split: '?' | first
              endif
            endif

            assign poster_image = block.settings.thumbnail
            if poster_image == blank and block.settings.video != blank
              assign poster_image = block.settings.video.preview_image
            endif

            assign shopify_youtube_id = ''
            assign shopify_vimeo_id = ''
            if block.settings.video != blank
              if block.settings.video.host == 'youtube'
                assign shopify_youtube_id = block.settings.video.external_id
              elsif block.settings.video.host == 'vimeo'
                assign shopify_vimeo_id = block.settings.video.external_id
              endif
            endif

            if shopify_youtube_id != blank
              assign youtube_id = shopify_youtube_id
            endif

            assign has_native_video = false
            if has_shopify_video and shopify_youtube_id == blank and shopify_vimeo_id == blank
              assign has_native_video = true
            elsif has_external_video and youtube_id == blank and shopify_vimeo_id == blank
              assign has_native_video = true
            endif

            assign has_embed_video = false
            if youtube_id != blank or shopify_vimeo_id != blank
              assign has_embed_video = true
            endif

            assign video_poster_url = blank
            if poster_image != blank
              assign video_poster_url = poster_image | image_url: width: 800
            endif

            assign embed_poster_url = blank
            if has_embed_video
              if poster_image != blank
                assign embed_poster_url = poster_image | image_url: width: 800
              elsif youtube_id != blank
                assign embed_poster_url = 'https://img.youtube.com/vi/' | append: youtube_id | append: '/hqdefault.jpg'
              endif
            endif

            assign thumb_ratio = 'auto'
            if block.settings.aspect_ratio != 'default'
              assign thumb_ratio = block.settings.aspect_ratio
            elsif mobile_aspect_ratio == '9-16'
              assign thumb_ratio = '9-16'
            elsif mobile_aspect_ratio == '4-3'
              assign thumb_ratio = '4-3'
            elsif video_url contains 'shorts/'
              assign thumb_ratio = '9-16'
            elsif block.settings.video != blank and block.settings.video.aspect_ratio != blank
              if block.settings.video.aspect_ratio < 0.85
                assign thumb_ratio = '9-16'
              else
                assign thumb_ratio = '4-3'
              endif
            endif
          %}

          <article class="neeloos-video__card neeloos-video__card--ratio-{{ thumb_ratio }}" {{ block.shopify_attributes }}>
            <div class="neeloos-video__thumb-wrap">
              {% if block.settings.link != blank and has_shopify_video == false and has_external_video == false %}
                <a
                  href="{{ block.settings.link }}"
                  class="neeloos-video__media neeloos-video__media--link"
                  aria-label="{{ block.settings.caption | escape }}"
                >
              {% else %}
                <div
                  class="neeloos-video__media{% if has_shopify_video or has_external_video %} neeloos-video__media--has-video{% endif %}"
                  {% if has_shopify_video or has_external_video %}
                    data-neeloos-video-media
                    data-video-kind="{% if has_shopify_video %}{% if shopify_youtube_id != blank %}youtube{% elsif shopify_vimeo_id != blank %}vimeo{% else %}shopify{% endif %}{% elsif youtube_id != blank %}youtube{% else %}file{% endif %}"
                    {% if youtube_id != blank %}
                      data-youtube-id="{{ youtube_id }}"
                    {% endif %}
                    {% if shopify_vimeo_id != blank %}
                      data-vimeo-id="{{ shopify_vimeo_id }}"
                    {% endif %}
                    {% if video_poster_url != blank and has_native_video %}
                      data-poster-url="{{ video_poster_url }}"
                    {% endif %}
                    {% if has_external_video and youtube_id == blank and shopify_vimeo_id == blank %}
                      data-video-url="{{ block.settings.video_url | escape }}"
                    {% endif %}
                  {% endif %}
                >
              {% endif %}

                <div class="neeloos-video__thumb neeloos-video__thumb--ratio-{{ thumb_ratio }}" data-forge-slot-id="thumbnail"{% if poster_image == blank and has_native_video == false and has_embed_video == false and has_shopify_video == false and has_external_video == false %} data-forge-slot-blank="true"{% endif %}>
                  {% if has_native_video and has_shopify_video %}
                    {{
                      block.settings.video
                      | video_tag:
                        class: 'neeloos-video__player',
                        image_size: '1200x',
                        autoplay: false,
                        loop: video_loop,
                        muted: video_muted,
                        controls: false,
                        playsinline: true,
                        preload: 'metadata'
                    }}
                  {% elsif has_native_video and has_external_video %}
                    <video
                      class="neeloos-video__player"
                      playsinline
                      preload="metadata"
                      {% if video_loop %}loop{% endif %}
                      {% if video_muted %}muted{% endif %}
                      {% if video_poster_url != blank %}
                        poster="{{ video_poster_url }}"
                      {% endif %}
                    >
                      <source src="{{ block.settings.video_url }}" type="video/mp4">
                    </video>
                  {% elsif has_embed_video %}
                    <div class="neeloos-video__embed" data-embed-wrap hidden>
                      <iframe
                        class="neeloos-video__player neeloos-video__player--embed"
                        title="{{ block.settings.caption | default: 'Video' | escape }}"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                      ></iframe>
                    </div>
                  {% endif %}

                  {% if has_embed_video and embed_poster_url != blank %}
                    {% if poster_image != blank %}
                      {{
                        poster_image
                        | image_url: width: 800
                        | image_tag:
                          class: 'neeloos-video__poster',
                          loading: 'lazy',
                          widths: '320, 400, 500, 600, 800',
                          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 75vw',
                          alt: poster_image.alt | default: block.settings.caption
                      }}
                    {% else %}
                      {% # theme-check-disable RemoteAsset %}
                      <img
                        class="neeloos-video__poster"
                        src="{{ embed_poster_url }}"
                        alt="{{ block.settings.caption | default: 'Video thumbnail' | escape }}"
                        loading="lazy"
                        width="800"
                        height="450"
                      >
                      {% # theme-check-enable RemoteAsset %}
                    {% endif %}
                  {% elsif has_native_video == false and has_embed_video == false and has_shopify_video == false and has_external_video == false %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'neeloos-video__poster neeloos-video__poster--placeholder' }}
                  {% endif %}

                  {% if has_shopify_video or has_external_video %}
                    <button
                      type="button"
                      class="neeloos-video__play"
                      data-play-button
                      aria-label="{{ 'accessibility.play_video' | t | default: 'Play video' }}: {{ block.settings.caption | escape }}"
                    >
                      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="24" cy="24" r="24" fill="white" fill-opacity="0.95"/>
                        <path d="M20 16.5v15l12-7.5-12-7.5z" fill="#2b211b"/>
                      </svg>
                    </button>
                    <span class="neeloos-video__duration" data-duration hidden>0:00</span>
                    {% if show_mute_button and has_native_video %}
                      <button
                        type="button"
                        class="neeloos-video__mute"
                        data-mute-button
                        hidden
                        aria-pressed="{% if video_muted %}true{% else %}false{% endif %}"
                        aria-label="{% if video_muted %}Unmute video{% else %}Mute video{% endif %}"
                      >
                        <span class="neeloos-video__mute-icon neeloos-video__mute-icon--muted" aria-hidden="true"{% unless video_muted %} hidden{% endunless %}>
                          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M11 5L6 9H3v6h3l5 4V5z" fill="currentColor"/>
                            <path d="M16 10l6 6M22 10l-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                          </svg>
                        </span>
                        <span class="neeloos-video__mute-icon neeloos-video__mute-icon--unmuted" aria-hidden="true"{% if video_muted %} hidden{% endif %}>
                          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M11 5L6 9H3v6h3l5 4V5z" fill="currentColor"/>
                            <path d="M15.54 8.46a5 5 0 010 7.07M19.07 4.93a9 9 0 010 14.14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                          </svg>
                        </span>
                      </button>
                    {% endif %}
                  {% elsif block.settings.link == blank %}
                    <span class="neeloos-video__play neeloos-video__play--static" aria-hidden="true">
                      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="24" cy="24" r="24" fill="white" fill-opacity="0.95"/>
                        <path d="M20 16.5v15l12-7.5-12-7.5z" fill="#2b211b"/>
                      </svg>
                    </span>
                  {% endif %}
                </div>

              {% if block.settings.link != blank and has_shopify_video == false and has_external_video == false %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>

            {% if block.settings.caption != blank %}
              <h3 class="neeloos-video__caption">{{ block.settings.caption }}</h3>
            {% endif %}

            {% if has_shopify_video and shopify_youtube_id == blank and shopify_vimeo_id == blank %}
              <template data-neeloos-video-template>
                {{
                  block.settings.video
                  | video_tag:
                    class: 'neeloos-video__modal-player',
                    image_size: '1200x',
                    autoplay: true,
                    loop: video_loop,
                    muted: video_muted,
                    controls: true,
                    playsinline: true
                }}
              </template>
            {% endif %}
          </article>
        {% endfor %}
        </div>
        <div class="neeloos-video__dots" data-dots role="tablist" aria-label="Video slides"></div>

        <dialog class="neeloos-video__modal" data-neeloos-video-modal aria-label="Video player">
          <button type="button" class="neeloos-video__modal-close" data-neeloos-video-close aria-label="Close video">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="neeloos-video__modal-body" data-neeloos-video-modal-body></div>
        </dialog>
      </neeloos-video-carousel>
    {% else %}
      {% assign default_captions = 'Ragi Banana Porridge in 3 Easy Steps|Sathu Maavu Mix Quick Recipe|How My Baby Loves Neeloos Every Day|Travel-Friendly Nutritious Meals' | split: '|' %}
      <neeloos-video-carousel
        class="neeloos-video__carousel"
        data-mobile-layout="{{ mobile_layout }}"
        data-autoplay="{% if section.settings.mobile_autoplay %}true{% else %}false{% endif %}"
        data-autoplay-speed="{{ section.settings.mobile_autoplay_speed }}"
        data-slide-duration="{{ section.settings.mobile_slide_duration }}"
        data-mobile-aspect="{{ mobile_aspect_ratio }}"
        data-video-autoplay="{% if video_autoplay %}true{% else %}false{% endif %}"
        data-video-muted="{% if video_muted %}true{% else %}false{% endif %}"
        data-show-mute-button="{% if show_mute_button %}true{% else %}false{% endif %}"
        data-video-loop="{% if video_loop %}true{% else %}false{% endif %}"
        data-desktop-popup="{% if desktop_video_playback == 'popup' %}true{% else %}false{% endif %}"
      >
        <div class="neeloos-video__grid" data-track>
        {% for i in (0..3) %}
          <article class="neeloos-video__card">
            <div class="neeloos-video__thumb-wrap">
              <div class="neeloos-video__media">
                <div class="neeloos-video__thumb" data-forge-slot-blank="true">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'neeloos-video__poster neeloos-video__poster--placeholder' }}
                  <span class="neeloos-video__play neeloos-video__play--static" aria-hidden="true">
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="24" cy="24" r="24" fill="white" fill-opacity="0.95"/>
                      <path d="M20 16.5v15l12-7.5-12-7.5z" fill="#2b211b"/>
                    </svg>
                  </span>
                </div>
              </div>
            </div>
            <h3 class="neeloos-video__caption">{{ default_captions[i] }}</h3>
          </article>
        {% endfor %}
        </div>
        <div class="neeloos-video__dots" data-dots role="tablist" aria-label="Video slides"></div>

        <dialog class="neeloos-video__modal" data-neeloos-video-modal aria-label="Video player">
          <button type="button" class="neeloos-video__modal-close" data-neeloos-video-close aria-label="Close video">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="neeloos-video__modal-body" data-neeloos-video-modal-body></div>
        </dialog>
      </neeloos-video-carousel>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .neeloos-video {
    position: relative;
    width: 100%;
  }

  .neeloos-video__inner {
    margin: 0 auto;
    max-width: 1280px;
    position: relative;
    z-index: 1;
  }

  .neeloos-video__header {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    justify-content: space-between;
    margin-bottom: 36px;
  }

  .neeloos-video__title {
    align-items: center;
    color: var(--neeloos-video-title-color, var(--color-foreground-heading));
    display: inline-flex;
    flex: 1 1 auto;
    font-family: var(--font-heading--family);
    font-size: var(--neeloos-video-heading-size);
    font-weight: 400;
    gap: 10px;
    line-height: 1.2;
    margin: 0;
    min-width: 0;
  }

  .neeloos-video__leaf {
    color: var(--neeloos-video-leaf-color);
    display: inline-flex;
    flex-shrink: 0;
    height: 0.5em;
    width: 0.72em;
  }

  .neeloos-video__leaf svg {
    height: 100%;
    width: 100%;
  }

  .neeloos-video__link {
    align-items: center;
    color: var(--neeloos-video-link-color);
    display: inline-flex;
    flex-shrink: 0;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 500;
    gap: 6px;
    text-decoration: none;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .neeloos-video__link:hover {
    opacity: 0.8;
  }

  .neeloos-video__link-arrow {
    font-size: 1.1em;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .neeloos-video__link:hover .neeloos-video__link-arrow {
    transform: translateX(3px);
  }

  .neeloos-video__grid {
    display: grid;
    gap: var(--neeloos-video-gap);
    grid-template-columns: repeat(var(--neeloos-video-columns), minmax(0, 1fr));
  }

  .neeloos-video__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .neeloos-video__thumb-wrap {
    width: 100%;
  }

  .neeloos-video__media {
    display: block;
    width: 100%;
  }

  .neeloos-video__media--link {
    text-decoration: none;
  }

  .neeloos-video__thumb {
    aspect-ratio: 4 / 3;
    background: rgb(43 33 27 / 0.06);
    border-radius: var(--neeloos-video-thumb-radius);
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .neeloos-video__poster,
  .neeloos-video__poster--placeholder {
    display: block;
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    transition: opacity 0.25s ease;
    width: 100%;
    z-index: 1;
  }

  .neeloos-video__poster--placeholder {
    background: rgb(43 33 27 / 0.06);
  }

  .neeloos-video__player {
    display: block;
    height: 100%;
    inset: 0;
    left: 0;
    object-fit: cover;
    pointer-events: none;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 0;
  }

  .neeloos-video__player--embed {
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 2;
  }

  .neeloos-video__embed {
    border: 0;
    height: 100%;
    inset: 0;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 2;
  }

  .neeloos-video__embed[hidden] {
    display: none;
  }

  .neeloos-video__thumb.is-playing .neeloos-video__poster {
    opacity: 0;
    pointer-events: none;
  }

  .neeloos-video__thumb.is-playing .neeloos-video__player--embed,
  .neeloos-video__thumb.is-playing .neeloos-video__embed {
    opacity: 1;
    pointer-events: auto;
  }

  .neeloos-video__thumb.is-playing .neeloos-video__player:not(.neeloos-video__player--embed) {
    pointer-events: auto;
    z-index: 2;
  }

  .neeloos-video__play {
    background: none;
    border: 0;
    cursor: pointer;
    left: 50%;
    padding: 0;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease, transform 0.2s ease;
    width: clamp(44px, 12%, 56px);
    z-index: 2;
  }

  .neeloos-video__play--static {
    cursor: default;
    pointer-events: none;
  }

  .neeloos-video__play svg {
    display: block;
