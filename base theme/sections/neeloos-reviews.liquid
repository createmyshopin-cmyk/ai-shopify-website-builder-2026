{% liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign cards_desktop = section.settings.cards_per_view | default: 3
  assign mobile_card_ratio = section.settings.mobile_card_ratio | default: '4-3'
  if mobile_card_ratio == '4-5' or mobile_card_ratio == '4-8'
    assign mobile_card_ratio = '4-7'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --neeloos-reviews-heading-size: {{ section.settings.heading_font_size }}px;
    --neeloos-reviews-leaf-color: {{ section.settings.leaf_color }};
    --neeloos-reviews-title-color: {{ section.settings.title_color }};
    --neeloos-reviews-link-color: {{ section.settings.link_color }};
    --neeloos-reviews-star-color: {{ section.settings.star_color }};
    --neeloos-reviews-card-bg: {{ section.settings.card_background }};
    --neeloos-reviews-card-border: {{ section.settings.card_border_color }};
    --neeloos-reviews-card-radius: {{ section.settings.card_border_radius }}px;
    --neeloos-reviews-text-color: {{ section.settings.review_text_color }};
    --neeloos-reviews-author-color: {{ section.settings.author_color }};
    --neeloos-reviews-dot-active: {{ section.settings.dot_active_color }};
    --neeloos-reviews-dot-inactive: {{ section.settings.dot_inactive_color }};
    --neeloos-reviews-gap: {{ section.settings.card_gap }}px;
    --neeloos-reviews-card-padding: {{ section.settings.card_padding }}px;
    --neeloos-reviews-avatar-size: {{ section.settings.avatar_size }}px;
    --neeloos-reviews-cards-desktop: {{ cards_desktop }};
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --neeloos-reviews-heading-size: {{ section.settings.heading_font_size_mobile }}px;
      --neeloos-reviews-gap: {{ section.settings.card_gap_mobile }}px;
      --neeloos-reviews-card-padding: {{ section.settings.card_padding_mobile }}px;
      --neeloos-reviews-avatar-size: {{ section.settings.avatar_size_mobile }}px;
      {%- if section.settings.mobile_peek_amount < 10 -%}
        --neeloos-reviews-cards-mobile: 2.0{{ section.settings.mobile_peek_amount }};
      {%- else -%}
        --neeloos-reviews-cards-mobile: 2.{{ section.settings.mobile_peek_amount }};
      {%- endif -%}
    }
  }

  #shopify-section-{{ section.id }} .neeloos-reviews__title,
  #shopify-section-{{ section.id }} h2.neeloos-reviews__title {
    font-size: var(--neeloos-reviews-heading-size) !important;
  }
{% endstyle %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    neeloos
    neeloos-reviews
    neeloos-reviews--mobile-ratio-{{ mobile_card_ratio }}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="neeloos__inner">
    <div class="neeloos-reviews__header">
      {% if section.settings.show_view_all and section.settings.view_all_text != blank %}
        <a
          href="{{ section.settings.view_all_link | default: '#' }}"
          class="neeloos-reviews__view-all"
        >
          <span>{{ section.settings.view_all_text }}</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.show_heading %}
        <h2 class="neeloos__title neeloos-reviews__title {{ section.settings.heading_type_preset | default: 'h2' }} {{ section.settings.heading_type_preset | default: 'h2' }}">
          <span>{{ section.settings.heading }}</span>
          {% if section.settings.show_leaf_icons %}
            <span class="neeloos__leaf neeloos__leaf--right" aria-hidden="true">
              <svg viewBox="0 0 42 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 19C10 19 5 13 3 5c8 0 15 3 18 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path d="M24 16C25 8 31 3 39 2c-1 8-6 14-15 16" fill="currentColor" opacity=".75"/>
                <path d="M7 12c9 2 18 7 27 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </span>
          {% endif %}
        </h2>
      {% endif %}
    </div>

    <neeloos-reviews-carousel
      class="neeloos-reviews__carousel"
      data-cards-desktop="{{ cards_desktop }}"
      data-cards-tablet="{{ section.settings.cards_per_view_tablet }}"
      data-auto-scroll="{{ section.settings.auto_scroll }}"
      data-auto-scroll-speed="{{ section.settings.auto_scroll_speed }}"
    >
      <div class="neeloos-reviews__slider">
        <button
          class="neeloos-reviews__nav neeloos-reviews__nav--prev"
          type="button"
          data-prev
          aria-label="Previous reviews"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="neeloos-reviews__track-wrapper">
          <div class="neeloos-reviews__track" data-track>
            {% if review_blocks.size > 0 %}
              {% for block in review_blocks %}
                <article class="neeloos-reviews__card" {{ block.shopify_attributes }}>
                  <div class="neeloos-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                    {% for star in (1..5) %}
                      <svg class="neeloos-reviews__star{% if star > block.settings.rating %} neeloos-reviews__star--empty{% endif %}" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% endfor %}
                  </div>

                  {% if block.settings.text != blank %}
                    <blockquote class="neeloos-reviews__text">{{ block.settings.text }}</blockquote>
                  {% endif %}

                  <footer class="neeloos-reviews__footer">
                    {% if block.settings.author != blank %}
                      <p class="neeloos-reviews__author">
                        {% if block.settings.author_prefix != blank %}{{ block.settings.author_prefix }}{% else %}-{% endif %}
                        {{ block.settings.author }}{% if block.settings.location != blank %}, {{ block.settings.location }}{% endif %}
                      </p>
                    {% endif %}

                    <div class="neeloos-reviews__avatar">
                      {% if block.settings.avatar != blank %}
                        {{
                          block.settings.avatar
                          | image_url: width: 120
                          | image_tag:
                            class: 'neeloos-reviews__avatar-img',
                            loading: 'lazy',
                            widths: '48, 64, 80, 96, 120',
                            alt: block.settings.author | default: 'Reviewer'
                        }}
                      {% else %}
                        <span class="neeloos-reviews__avatar-placeholder" aria-hidden="true">
                          {% if block.settings.author != blank %}
                            {{ block.settings.author | slice: 0 }}
                          {% else %}
                            ?
                          {% endif %}
                        </span>
                      {% endif %}
                    </div>
                  </footer>
                </article>
              {% endfor %}
            {% else %}
              {% assign default_texts = "Neeloos has made feeding my baby so easy. I'm relieved to know it's healthy and traditional.|As a working mom, Neeloos saves my time and gives me peace of mind. Highly recommend!|My baby loves the taste and I love the ingredients. Thank you Neeloos!" | split: '|' %}
              {% assign default_authors = 'Anjali|Reshma|Divya' | split: '|' %}
              {% assign default_locations = 'Kochi|Calicut|Trivandrum' | split: '|' %}
              {% for i in (0..2) %}
                <article class="neeloos-reviews__card">
                  <div class="neeloos-reviews__stars" aria-label="5 out of 5 stars">
                    {% for star in (1..5) %}
                      <svg class="neeloos-reviews__star" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% endfor %}
                  </div>
                  <blockquote class="neeloos-reviews__text">{{ default_texts[i] }}</blockquote>
                  <footer class="neeloos-reviews__footer">
                    <p class="neeloos-reviews__author">- {{ default_authors[i] }}, {{ default_locations[i] }}</p>
                    <div class="neeloos-reviews__avatar">
                      <span class="neeloos-reviews__avatar-placeholder" aria-hidden="true">{{ default_authors[i] | slice: 0 }}</span>
                    </div>
                  </footer>
                </article>
              {% endfor %}
            {% endif %}
          </div>
        </div>

        <button
          class="neeloos-reviews__nav neeloos-reviews__nav--next"
          type="button"
          data-next
          aria-label="Next reviews"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="neeloos-reviews__dots" data-dots role="tablist" aria-label="Review slides"></div>
    </neeloos-reviews-carousel>
  </div>
</div>

{% stylesheet %}
  .neeloos-reviews {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .neeloos-reviews .neeloos__inner {
    margin: 0 auto;
    max-width: 1280px;
    position: relative;
    z-index: 1;
  }

  .neeloos-reviews .neeloos__title {
    align-items: center;
    display: inline-flex;
    font-family: var(--font-heading--family);
    font-weight: 400;
    gap: 14px;
    justify-content: center;
    line-height: 1.15;
    margin: 0;
  }

  .neeloos-reviews .neeloos__leaf {
    display: inline-flex;
    flex-shrink: 0;
    height: 0.55em;
    width: 0.75em;
  }

  .neeloos-reviews .neeloos__leaf--left {
    transform: scaleX(-1);
  }

  .neeloos-reviews .neeloos__leaf--right {
    margin-inline-start: 2px;
  }

  .neeloos-reviews .neeloos__leaf svg {
    height: 100%;
    width: 100%;
  }

  .neeloos-reviews__header {
    margin-bottom: 40px;
    position: relative;
    text-align: center;
  }

  .neeloos-reviews__title {
    color: var(--neeloos-reviews-title-color, var(--color-foreground-heading));
  }

  .neeloos-reviews .neeloos__leaf {
    color: var(--neeloos-reviews-leaf-color);
  }

  .neeloos-reviews__view-all {
    align-items: center;
    color: var(--neeloos-reviews-link-color);
    display: inline-flex;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 500;
    gap: 6px;
    position: absolute;
    right: 0;
    text-decoration: none;
    top: 50%;
    transform: translateY(-50%);
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .neeloos-reviews__view-all:hover {
    opacity: 0.75;
  }

  .neeloos-reviews__view-all svg {
    flex-shrink: 0;
    height: 16px;
    width: 16px;
  }

  .neeloos-reviews__carousel {
    display: block;
  }

  .neeloos-reviews__slider {
    align-items: center;
    display: flex;
    gap: 12px;
    position: relative;
  }

  .neeloos-reviews__track-wrapper {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }

  .neeloos-reviews__track {
    display: flex;
    gap: var(--neeloos-reviews-gap);
    transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .neeloos-reviews__track {
      transition-duration: 0.01ms;
    }
  }

  .neeloos-reviews__card {
    background: var(--neeloos-reviews-card-bg);
    border: 1px solid var(--neeloos-reviews-card-border);
    border-radius: var(--neeloos-reviews-card-radius);
    box-sizing: border-box;
    display: flex;
    flex: 0 0 calc((100% - (var(--neeloos-reviews-gap) * (var(--neeloos-reviews-cards-desktop) - 1))) / var(--neeloos-reviews-cards-desktop));
    flex-direction: column;
    min-height: 220px;
    min-width: 0;
    padding: var(--neeloos-reviews-card-padding);
  }

  .neeloos-reviews__stars {
    display: flex;
    flex-shrink: 0;
    gap: 3px;
    margin-bottom: 16px;
  }

  .neeloos-reviews__star {
    fill: var(--neeloos-reviews-star-color);
    height: 18px;
    width: 18px;
  }

  .neeloos-reviews__star--empty {
    fill: rgb(0 0 0 / 0.12);
  }

  .neeloos-reviews__text {
    color: var(--neeloos-reviews-text-color);
    flex: 1 1 auto;
    font-family: var(--font-body--family);
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    font-style: normal;
    font-weight: 400;
    line-height: 1.55;
    margin: 0 0 24px;
  }

  .neeloos-reviews__footer {
    align-items: flex-end;
    display: flex;
    flex-shrink: 0;
    gap: 12px;
    justify-content: space-between;
    margin-top: auto;
  }

  .neeloos-reviews__author {
    color: var(--neeloos-reviews-author-color);
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
    min-width: 0;
  }

  .neeloos-reviews__avatar {
    flex-shrink: 0;
    height: var(--neeloos-reviews-avatar-size);
    width: var(--neeloos-reviews-avatar-size);
  }

  .neeloos-reviews__avatar-img {
    border-radius: 50%;
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .neeloos-reviews__avatar-placeholder {
    align-items: center;
    background: rgb(0 0 0 / 0.06);
    border-radius: 50%;
    color: var(--neeloos-reviews-author-color);
    display: flex;
    font-family: var(--font-body--family);
    font-size: calc(var(--neeloos-reviews-avatar-size) * 0.38);
    font-weight: 600;
    height: 100%;
    justify-content: center;
    text-transform: uppercase;
    width: 100%;
  }

  .neeloos-reviews__nav {
    align-items: center;
    background: #fff;
    border: none;
    border-radius: 50%;
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.08);
    color: rgb(0 0 0 / 0.45);
    cursor: pointer;
    display: flex;
    flex-shrink: 0;
    height: 44px;
    justify-content: center;
    transition: box-shadow 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
    width: 44px;
  }

  .neeloos-reviews__nav:hover:not(:disabled) {
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
    transform: scale(1.04);
  }

  .neeloos-reviews__nav:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .neeloos-reviews__nav svg {
    height: 20px;
    width: 20px;
  }

  .neeloos-reviews__dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 28px;
  }

  .neeloos-reviews__dot {
    background: var(--neeloos-reviews-dot-inactive);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    height: 8px;
    padding: 0;
    transition: background 0.25s ease, transform 0.25s ease;
    width: 8px;
  }

  .neeloos-reviews__dot[aria-selected='true'] {
    background: var(--neeloos-reviews-dot-active);
    transform: scale(1.15);
  }

  @media screen and (max-width: 989px) {
    .neeloos-reviews__card {
      flex: 0 0 calc((100% - var(--neeloos-reviews-gap)) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .neeloos-reviews {
      overflow-x: clip;
    }

    .neeloos-reviews .neeloos__inner {
      box-sizing: border-box;
      max-width: 100%;
      padding-inline: var(--page-margin, 16px);
      width: 100%;
    }

    .neeloos-reviews__header {
      align-items: stretch;
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 28px;
      padding-top: 0;
    }

    .neeloos-reviews__view-all {
      align-self: flex-end;
      font-size: 0.8125rem;
      order: -1;
      position: static;
      right: auto;
      top: auto;
      transform: none;
    }

    .neeloos-reviews__title {
      gap: 10px;
      justify-content: center;
      max-width: 100%;
      text-align: center;
      text-wrap: balance;
    }

    .neeloos-reviews__slider {
      gap: 0;
    }

    .neeloos-reviews__nav {
      display: none;
    }

    .neeloos-reviews__card {
      flex: 0 0 calc((100% - (var(--neeloos-reviews-gap) * (var(--neeloos-reviews-cards-mobile) - 1))) / var(--neeloos-reviews-cards-mobile));
      min-height: 0;
      overflow: hidden;
    }

    .neeloos-reviews--mobile-ratio-auto .neeloos-reviews__card {
      aspect-ratio: auto;
      min-height: 180px;
    }

    .neeloos-reviews--mobile-ratio-1-1 .neeloos-reviews__card {
      aspect-ratio: 1 / 1;
    }

    .neeloos-reviews--mobile-ratio-4-7 .neeloos-reviews__card {
      aspect-ratio: 4 / 7;
    }

    .neeloos-reviews--mobile-ratio-5-6 .neeloos-reviews__card {
      aspect-ratio: 5 / 6;
    }

    .neeloos-reviews--mobile-ratio-4-3 .neeloos-reviews__card {
      aspect-ratio: 4 / 3;
    }

    .neeloos-reviews--mobile-ratio-3-2 .neeloos-reviews__card {
      aspect-ratio: 3 / 2;
    }

    .neeloos-reviews__stars {
      margin-bottom: 12px;
    }

    .neeloos-reviews--mobile-ratio-auto .neeloos-reviews__text {
      display: block;
      overflow: visible;
    }

    .neeloos-reviews--mobile-ratio-1-1 .neeloos-reviews__text,
    .neeloos-reviews--mobile-ratio-5-6 .neeloos-reviews__text {
      line-clamp: 5;
      -webkit-line-clamp: 5;
    }

    .neeloos-reviews--mobile-ratio-4-7 .neeloos-reviews__text {
      line-clamp: 7;
      -webkit-line-clamp: 7;
    }

    .neeloos-reviews--mobile-ratio-4-3 .neeloos-reviews__text {
      line-clamp: 4;
      -webkit-line-clamp: 4;
    }

    .neeloos-reviews--mobile-ratio-3-2 .neeloos-reviews__text {
      line-clamp: 3;
      -webkit-line-clamp: 3;
    }

    .neeloos-reviews__text {
      flex: 1 1 auto;
      font-size: 0.8125rem;
      margin-bottom: 12px;
      min-height: 0;
    }

    .neeloos-reviews:not(.neeloos-reviews--mobile-ratio-auto) .neeloos-reviews__text {
      -webkit-box-orient: vertical;
      display: -webkit-box;
      overflow: hidden;
    }

    .neeloos-reviews__author {
      font-size: 0.8125rem;
    }

    .neeloos-reviews__dots {
      margin-top: 20px;
    }
  }
{% endstylesheet %}

{% javascript %}
  class NeeloosReviewsCarousel extends HTMLElement {
    constructor() {
      super();
      this.currentIndex = 0;
      this.isPaused = false;
      this.cardsPerViewDesktop = parseInt(this.dataset.cardsDesktop, 10) || 3;
      this.cardsPerViewTablet = parseInt(this.dataset.cardsTablet, 10) || 2;
      this.autoScrollEnabled = this.dataset.autoScroll === 'true';
      this.autoScrollSpeed = (parseInt(this.dataset.autoScrollSpeed, 10) || 5) * 1000;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    connectedCallback() {
      this.track = this.querySelector('[data-track]');
      this.prevButton = this.querySelector('[data-prev]');
      this.nextButton = this.querySelector('[data-next]');
      this.dotsContainer = this.querySelector('[data-dots]');
      this.cards = Array.from(this.track?.children || []);

      if (this.cards.length === 0) return;

      this.updateCardsPerView();
      this.createDots();
      this.bindEvents();
      this.updateCarousel();
      this.startAutoplay();

      this.resizeObserver = new ResizeObserver(() => {
        this.updateCardsPerView();
        this.createDots();
        this.updateCarousel();
      });
      this.resizeObserver.observe(this);

      this.reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.onReducedMotionChange = (event) => {
        this.reducedMotion = event.matches;
        if (this.reducedMotion) {
          this.stopAutoplay();
        } else {
          this.startAutoplay();
        }
      };
      this.reducedMotionQuery.addEventListener('change', this.onReducedMotionChange);
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
      this.stopAutoplay();
      this.reducedMotionQuery?.removeEventListener('change', this.onReducedMotionChange);
    }

    get isMobilePeek() {
      return window.innerWidth <= 749;
    }

    updateCardsPerView() {
      if (this.isMobilePeek) {
        this.activeCardsPerView = 2;
        this.scrollStep = 1;
      } else if (window.innerWidth <= 989) {
        this.activeCardsPerView = this.cardsPerViewTablet;
        this.scrollStep = 1;
      } else {
        this.activeCardsPerView = this.cardsPerViewDesktop;
        this.scrollStep = 1;
      }

      const maxIndex = this.getMaxIndex();
      if (this.currentIndex > maxIndex) {
        this.currentIndex = maxIndex;
      }
    }

    getMaxIndex() {
      if (this.isMobilePeek) {
        return Math.max(0, this.cards.length - 2);
      }
      return Math.max(0, this.cards.length - this.activeCardsPerView);
    }

    getTotalDots() {
      return Math.max(1, this.getMaxIndex() + 1);
    }

    createDots() {
      if (!this.dotsContainer) return;

      this.dotsContainer.innerHTML = '';
      const totalDots = this.getTotalDots();

      for (let i = 0; i < totalDots; i++) {
        const dot = document.createElement('button');
        dot.className = 'neeloos-reviews__dot';
        dot.type = 'button';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `Go to review slide ${i + 1}`);
        dot.setAttribute('aria-selected', i === this.currentIndex ? 'true' : 'false');
        dot.addEventListener('click', () => {
          this.goToIndex(i);
        });
        this.dotsContainer.appendChild(dot);
      }
    }

    goToIndex(index) {
      this.currentIndex = Math.min(Math.max(index, 0), this.getMaxIndex());
      this.updateCarousel();
      this.restartAutoplay();
    }

    prev() {
      if (this.currentIndex > 0) {
        this.currentIndex--;
      } else if (this.autoScrollEnabled) {
        this.currentIndex = this.getMaxIndex();
      }
      this.updateCarousel();
      this.restartAutoplay();
    }

    next() {
      const maxIndex = this.getMaxIndex();
      if (this.currentIndex < maxIndex) {
        this.currentIndex++;
      } else if (this.autoScrollEnabled) {
        this.currentIndex = 0;
      }
      this.updateCarousel();
      this.restartAutoplay();
    }

    bindEvents() {
      this.prevButton?.addEventListener('click', () => this.prev());
      this.nextButton?.addEventListener('click', () => this.next());

      let startX = 0;
      let currentX = 0;

      this.track?.addEventListener('touchstart', (event) => {
        startX = event.touches[0].clientX;
        this.pauseAutoplay();
      }, { passive: true });

      this.track?.addEventListener('touchmove', (event) => {
        currentX = event.touches[0].clientX;
      }, { passive: true });

      this.track?.addEventListener('touchend', () => {
        const diff = startX - currentX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) this.next();
          else this.prev();
        }
        this.resumeAutoplay();
      });

      this.addEventListener('mouseenter', () => this.pauseAutoplay());
      this.addEventListener('mouseleave', () => this.resumeAutoplay());

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          this.pauseAutoplay();
        } else {
          this.resumeAutoplay();
        }
      });
    }

    startAutoplay() {
      if (!this.autoScrollEnabled || this.reducedMotion) return;
      this.stopAutoplay();
      this.autoplayTimer = setInterval(() => {
        if (this.isPaused) return;
        this.next();
      }, this.autoScrollSpeed);
    }

    stopAutoplay() {
      if (this.autoplayTimer) {
        clearInterval(this.autoplayTimer);
        this.autoplayTimer = null;
      }
    }

    pauseAutoplay() {
      this.isPaused = true;
    }

    resumeAutoplay() {
      this.isPaused = false;
    }

    restartAutoplay() {
      this.stopAutoplay();
      this.startAutoplay();
    }

    updateCarousel() {
      const card = this.cards[0];
      if (!card || !this.track) return;

      const cardWidth = card.offsetWidth;
      const gap = parseInt(getComputedStyle(this.track).gap, 10) || 0;
      const offset = -(this.currentIndex * (cardWidth + gap));

      this.track.style.transform = `translateX(${offset}px)`;

      const maxIndex = this.getMaxIndex();

      if (this.prevButton) {
        this.prevButton.disabled = !this.autoScrollEnabled && this.currentIndex === 0;
      }
      if (this.nextButton) {
        this.nextButton.disabled = !this.autoScrollEnabled && this.currentIndex >= maxIndex;
      }

      this.dotsContainer?.querySelectorAll('.neeloos-reviews__dot').forEach((dot, index) => {
        dot.setAttribute('aria-selected', index === this.currentIndex ? 'true' : 'false');
      });
    }
  }

  if (!customElements.get('neeloos-reviews-carousel')) {
    customElements.define('neeloos-reviews-carousel', NeeloosReviewsCarousel);
  }
{% endjavascript %}

