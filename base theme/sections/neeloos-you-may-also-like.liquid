<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign max_products = section.settings.max_products | default: 4
  assign context_product = section.settings.product | default: product
  assign recommendation_intent = section.settings.recommendation_type | default: 'related'
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --ymal-columns: {{ section.settings.columns }};
    --ymal-gap: {{ section.settings.gap }}px;
    --section-border-radius: {{ section.settings.card_border_radius }}px;
    --ymal-heading-size: {{ section.settings.heading_font_size }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --ymal-columns: {{ section.settings.columns_mobile }};
      --ymal-gap: {{ section.settings.gap_mobile }}px;
      --ymal-heading-size: {{ section.settings.heading_font_size_mobile }}px;
    }
  }

  #shopify-section-{{ section.id }} .bestseller-card,
  #shopify-section-{{ section.id }} .bestseller-card__age-badge,
  #shopify-section-{{ section.id }} .bestseller-card__cta .product-card-card-2-cta__button,
  #shopify-section-{{ section.id }} .bestseller-card__button {
    border-radius: var(--section-border-radius) !important;
  }
{% endstyle %}

<product-recommendations
  id="neeloos-ymal-{{ section.id }}"
  class="neeloos-ymal-recommendations"
  data-url="{{ routes.product_recommendations_url }}?limit={{ max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ context_product.id }}"
  data-intent="{{ recommendation_intent }}"
  data-recommendations-performed="{{ recommendations.performed }}"
  {{ section.shopify_attributes }}
>
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="neeloos-ymal section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% if section.settings.heading != blank %}
      <header class="neeloos-ymal__header">
        <h2 class="neeloos-ymal__heading">
          <span>{{ section.settings.heading }}</span>
          {% if section.settings.show_leaf_icon %}
            <span class="neeloos-ymal__leaf" aria-hidden="true">
              <svg viewBox="0 0 42 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 19C10 19 5 13 3 5c8 0 15 3 18 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <path d="M24 16C25 8 31 3 39 2c-1 8-6 14-15 16" fill="currentColor" opacity=".75"/>
                <path d="M7 12c9 2 18 7 27 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </span>
          {% endif %}
        </h2>
      </header>
    {% endif %}

    {%- if recommendations.performed or context_product == blank -%}
      {% liquid
        if context_product == blank
          assign products_to_show = null
          for i in (1..max_products)
            assign products_to_show = products_to_show | append: ', '
            assign products_to_show = products_to_show | split: ','
          endfor
        elsif recommendations.performed and recommendations.products_count == 0
          if recommendation_intent == 'related'
            assign products_to_show = collections.all.products | reject: 'id', context_product.id
          else
            assign products_to_show = null
          endif
        else
          assign products_to_show = recommendations.products
        endif

        if products_to_show != blank and products_to_show.size > 0
          assign has_recommendations = true
        else
          assign has_recommendations = false
        endif
      %}

      <div
        class="neeloos-ymal__grid"
        data-has-recommendations="{{ has_recommendations }}"
      >
        {% if has_recommendations %}
          {% for card_product in products_to_show limit: max_products %}
            {% render 'bestseller-card',
              product: card_product,
              section_id: section.id,
              product_title_type_preset: 'h5',
              fallback_index: forloop.index0
            %}
          {% endfor %}
        {% endif %}
      </div>
    {%- else -%}
      <div class="neeloos-ymal__grid neeloos-ymal__grid--loading" aria-hidden="true">
        {% for i in (1..max_products) %}
          {% render 'bestseller-card',
            product: blank,
            section_id: section.id,
            product_title_type_preset: 'h5',
            fallback_index: forloop.index0
          %}
        {% endfor %}
      </div>
    {%- endif -%}
  </div>
</product-recommendations>

{% stylesheet %}
  .neeloos-ymal-recommendations.hidden {
    display: none;
  }

  .neeloos-ymal {
    --ymal-heading-color: var(--card-2-title-color, var(--color-foreground-heading));
  }

  .neeloos-ymal__header {
    margin-bottom: clamp(20px, 3vw, 32px);
  }

  .neeloos-ymal__heading {
    align-items: center;
    color: var(--ymal-heading-color);
    display: inline-flex;
    font-family: var(--font-heading--family);
    font-size: var(--ymal-heading-size, clamp(1.5rem, 3vw, 2rem));
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    gap: 10px;
    line-height: 1.15;
    margin: 0;
  }

  .neeloos-ymal__leaf {
    color: var(--card-2-button-bg, #7b8e61);
    display: inline-flex;
    flex-shrink: 0;
    height: 22px;
    width: 34px;
  }

  .neeloos-ymal__leaf svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  .neeloos-ymal__grid {
    display: grid;
    gap: var(--ymal-gap, 24px);
    grid-template-columns: repeat(var(--ymal-columns, 4), minmax(0, 1fr));
  }

  .neeloos-ymal__grid .bestseller-card {
    height: 100%;
    min-width: 0;
    width: 100%;
  }

  .neeloos-ymal__grid--loading {
    opacity: 0.45;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .neeloos-ymal__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .neeloos-ymal {
      box-sizing: border-box;
      max-width: 100%;
      overflow-x: clip;
      width: 100%;
    }

    .neeloos-ymal__header {
      margin-bottom: 20px;
    }

    .neeloos-ymal__heading {
      flex-wrap: wrap;
      font-size: var(--ymal-heading-size, 24px) !important;
      max-width: 100%;
      min-width: 0;
      text-wrap: balance;
    }

    .neeloos-ymal__grid {
      gap: var(--ymal-gap, 14px);
      grid-template-columns: repeat(var(--ymal-columns, 2), minmax(0, 1fr));
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "You May Also Like",
  "tag": "section",
  "class": "ui-test-neeloos-ymal",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "checkbox",
      "id": "show_leaf_icon",
      "label": "Show leaf icon",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Recommendations"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product",
      "info": "Used for theme editor preview only. On the storefront, the current product page is used automatically."
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "t:settings.type",
      "options": [
        { "value": "related", "label": "t:options.related" },
        { "value": "complementary", "label": "t:options.complementary" }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards (desktop)",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between cards (mobile)",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "You May Also Like"
    }
  ]
}
{% endschema %}
