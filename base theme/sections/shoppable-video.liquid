{% # theme-check-disable RemoteAsset %}
<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js" defer></script>
{% # theme-check-enable RemoteAsset %}

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const moneyFormat = {{ shop.money_format | json }};
    const buttonText = {{ button | json }};
    const buttonSoldoutText = {{ button_soldout | json }};
    const modalButtonText = {{ modal_button | json }};
    const reloadAfterAdding = {{ reload_after_adding | json }};

    function formatMoney(cents, format) {
      if (typeof cents === 'string') cents = cents.replace('.', '');
      const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
      const formatString = format || moneyFormat;

      function formatWithDelimiters(number, precision, thousands, decimal) {
        precision = precision ?? 2;
        thousands = thousands ?? ',';
        decimal = decimal ?? '.';
        if (isNaN(number) || number == null) return '0';
        number = (number / 100.0).toFixed(precision);
        const parts = number.split('.');
        const dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        const centsPart = parts[1] ? decimal + parts[1] : '';
        return dollars + centsPart;
      }

      const match = formatString.match(placeholderRegex);
      if (!match) return cents;

      let value = '';
      switch (match[1]) {
        case 'amount':
          value = formatWithDelimiters(cents, 2);
          break;
        case 'amount_no_decimals':
          value = formatWithDelimiters(cents, 0);
          break;
        case 'amount_with_comma_separator':
          value = formatWithDelimiters(cents, 2, '.', ',');
          break;
        case 'amount_no_decimals_with_comma_separator':
          value = formatWithDelimiters(cents, 0, '.', ',');
          break;
        default:
          value = formatWithDelimiters(cents, 2);
      }
      return formatString.replace(placeholderRegex, value);
    }

    function updateProductFormVariant(formComponent, variant, availableText, soldOutText) {
      if (!formComponent || !variant) return;

      const variantInput = formComponent.refs?.variantId;
      const atcContainer = formComponent.refs?.addToCartButtonContainer;
      const atcButton = atcContainer?.refs?.addToCartButton;

      if (variantInput) variantInput.value = variant.id;

      if (!atcContainer || !atcButton) return;

      const textEl = atcButton.querySelector('.add-to-cart-text__content');

      if (!variant.available) {
        atcContainer.disable();
        if (textEl) textEl.textContent = soldOutText;
      } else {
        atcContainer.enable();
        if (textEl) textEl.textContent = availableText;
      }

      if (variant.featured_image?.src) {
        const imageSrc = variant.featured_image.src;
        const separator = imageSrc.includes('?') ? '&' : '?';
        atcContainer.setAttribute('data-product-variant-media', imageSrc + separator + 'width=100');
      }
    }

    function bindVariantSelects(selects, product, handlers) {
      if (!selects || !selects.length || !product) return;
      selects.forEach((select) => {
        select.addEventListener('change', () => {
          const selectedOptions = Array.from(selects).map((el) => el.value);
          const matchedVariant = findMatchedVariant(product, selectedOptions);
          if (!matchedVariant) return;
          handlers.onVariantChange(matchedVariant);
        });
      });
    }

    function findMatchedVariant(product, selectedOptions) {
      return product.variants.find((variant) => {
        for (let i = 0; i < selectedOptions.length; i++) {
          if (variant['option' + (i + 1)] !== selectedOptions[i]) return false;
        }
        return true;
      });
    }

    function pauseModalMedia(modal) {
      modal.querySelectorAll('iframe').forEach((frame) => {
        const mutedSrc = frame.getAttribute('data-src');
        if (mutedSrc) frame.src = mutedSrc;
      });
      modal.querySelectorAll('video').forEach((video) => video.pause());
    }

    function initShoppableVideo() {
      const sliderEl = document.querySelector('.video-slider-' + sectionId);
      if (!sliderEl || typeof Swiper === 'undefined') return;

      if (reloadAfterAdding) {
        const reloadKey = 'shoppableVideoReload-' + sectionId;
        if (!window[reloadKey]) {
          window[reloadKey] = true;
          document.addEventListener('cart:update', (event) => {
            const formComponent = event.target?.closest?.('product-form-component');
            if (!formComponent?.closest('#shopify-section-' + sectionId)) return;
            if (event.detail?.data?.didError) return;
            window.location.reload();
          });
        }
      }

      sliderEl.classList.remove('preview');

      if (sliderEl.swiper) sliderEl.swiper.destroy(true, true);

      const slider = new Swiper('.video-slider-' + sectionId, {
        speed: 300,
        breakpoints: {
          320: {
            spaceBetween: {{ slider_gap_mobile }},
            slidesPerView: {{ slider_view_mobile }}
          },
          768: {
            spaceBetween: {{ slider_gap_mobile }},
            slidesPerView: {{ slider_view | times: 0.5 | round: 0 }}
          },
          1024: {
            spaceBetween: {{ slider_gap }},
            slidesPerView: {{ slider_view }}
          }
        }
      });

      const modalSliderEl = document.querySelector('.video-modal-slider-' + sectionId);
      if (modalSliderEl?.swiper) modalSliderEl.swiper.destroy(true, true);

      const slider2 = new Swiper('.video-modal-slider-' + sectionId, {
        speed: 300,
        slidesPerView: 1,
        spaceBetween: 20,
        allowTouchMove: false,
        navigation: {
          nextEl: '.video-modal-next-' + sectionId,
          prevEl: '.video-modal-prev-' + sectionId
        },
        on: {
          slideChange() {
            this.slides.forEach((slide, index) => {
              const video = slide.querySelector('video');
              const frame = slide.querySelector('iframe');
              const btn = slide.querySelector('.video-modal-action-' + sectionId);
              const isActive = index === this.activeIndex;

              if (isActive) {
                if (video) {
                  video.play();
                  video.muted = false;
                }
                if (frame && frame.dataset.src2) frame.src = frame.dataset.src2;
                if (btn) btn.classList.add('active');
              } else {
                if (video) video.pause();
                if (frame && frame.dataset.src) frame.src = frame.dataset.src;
                if (btn) btn.classList.remove('active');
              }
            });
          }
        }
      });

      document.querySelectorAll('.video-slide-' + sectionId).forEach((slide) => {
        const arrowToggle = slide.querySelector('.video-arrow-' + sectionId);
        const variantsContainer = slide.querySelector('.video-variants-' + sectionId);
        if (arrowToggle && variantsContainer) {
          arrowToggle.addEventListener('click', () => variantsContainer.classList.toggle('active'));
        }
      });

      {% for block in section.blocks %}
        {% if block.settings.product != blank %}
          (function() {
            const product = {{ block.settings.product | json }};
            const selects = document.querySelectorAll('[data-shoppable-select--{{ block.id | replace: '-', '' }}]');
            const image = document.querySelector('[data-shoppable-image--{{ forloop.index }}]');
            const priceElement = document.querySelector('[data-shoppable-price--{{ forloop.index }}]');
            const optionPrice = document.querySelector('[data-shoppable-option-price--{{ forloop.index }}]');
            const formComponent = document.querySelector('[data-shoppable-form--{{ block.id }}]');

            bindVariantSelects(selects, product, {
              onVariantChange(variant) {
                if (priceElement) priceElement.textContent = formatMoney(variant.price, moneyFormat);
                if (optionPrice) optionPrice.textContent = formatMoney(variant.price, moneyFormat);
                if (image) {
                  if (variant.featured_image && variant.featured_image.src) {
                    image.src = variant.featured_image.src;
                  } else if (product.featured_image) {
                    image.src = product.featured_image;
                  }
                }
                updateProductFormVariant(formComponent, variant, buttonText, buttonSoldoutText);
              }
            });

            const modalSelects = document.querySelectorAll('[data-shoppable-modal-select--{{ block.id | replace: '-', '' }}]');
            const modalImage = document.querySelector('[data-shoppable-modal-image--{{ forloop.index }}]');
            const modalPriceElement = document.querySelector('[data-shoppable-modal-price--{{ forloop.index }}]');
            const modalFormComponent = document.querySelector('[data-shoppable-modal-form--{{ block.id }}]');

            bindVariantSelects(modalSelects, product, {
              onVariantChange(variant) {
                if (modalPriceElement) modalPriceElement.textContent = formatMoney(variant.price, moneyFormat);
                if (modalImage) {
                  if (variant.featured_image && variant.featured_image.src) {
                    modalImage.src = variant.featured_image.src;
                  } else if (product.featured_image) {
                    modalImage.src = product.featured_image;
                  }
                }
                updateProductFormVariant(modalFormComponent, variant, modalButtonText, {{ modal_button_soldout | json }});
              }
            });
          })();
        {% endif %}
      {% endfor %}

      const modal = document.querySelector('.video-modal-' + sectionId);
      const close = document.querySelector('.video-modal-close-' + sectionId);

      document.querySelectorAll('[data-shoppable-video-trigger]').forEach((trigger) => {
        if (!trigger.closest('.video-' + sectionId)) return;
        trigger.addEventListener('click', (event) => {
          if (event.target.closest('select, button, .video-variants-' + sectionId)) return;
          const index = Number(trigger.dataset.slideIndex || 0);
          slider2.slideTo(index);

          const activeSlide = slider2.slides[index];
          const video = activeSlide?.querySelector('video');
          const frame = activeSlide?.querySelector('iframe');
          const btn = activeSlide?.querySelector('.video-modal-action-' + sectionId);

          setTimeout(() => {
            document.body.style.overflow = 'hidden';
            modal.classList.add('active');
            modal.setAttribute('aria-hidden', 'false');
            if (video) {
              video.play();
              video.muted = false;
            }
            if (btn) btn.classList.add('active');
            if (frame && frame.dataset.src2) frame.src = frame.dataset.src2;
          }, 200);
        });
      });

      function closeModal() {
        document.body.style.overflow = '';
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
        pauseModalMedia(modal);
      }

      if (close) close.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', (event) => {
          if (event.target === modal) closeModal();
        });
      }

      document.querySelectorAll('.video-modal-slide-' + sectionId).forEach((slide) => {
        const btn = slide.querySelector('.video-modal-action-' + sectionId);
        const frame = slide.querySelector('iframe');
        const video = slide.querySelector('video');
        if (!btn) return;

        btn.addEventListener('click', (event) => {
          event.stopPropagation();
          btn.classList.toggle('active');
          const isUnmuted = btn.classList.contains('active');
          if (frame) {
            if (isUnmuted && frame.dataset.src2) {
              frame.src = frame.dataset.src2;
            } else if (frame.dataset.src) {
              frame.src = frame.dataset.src;
            }
          }
          if (video) video.muted = !isUnmuted;
        });
      });
    }

    function boot() {
      if (typeof Swiper === 'undefined') {
        setTimeout(boot, 50);
        return;
      }
      initShoppableVideo();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', (event) => {
        if (event.detail.sectionId === sectionId) boot();
      });
      document.addEventListener('shopify:section:unload', (event) => {
        if (event.detail.sectionId === sectionId) {
          const sliderEl = document.querySelector('.video-slider-' + sectionId);
          if (sliderEl?.swiper) sliderEl.swiper.destroy(true, true);
        }
      });
    }
  })();
</script>


