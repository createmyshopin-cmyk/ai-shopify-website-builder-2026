  .video-slider-{{ section.id }}.preview .video-slide-{{ section.id }} {
    width: calc(100% / {{ slider_view_mobile }} - {{ slider_gap_mobile }}px);
    flex-shrink: 0;
  }
  @media (min-width: 1024px) {
    .video-slider-{{ section.id }}.preview .swiper-wrapper {
      gap: {{ slider_gap }}px;
    }
