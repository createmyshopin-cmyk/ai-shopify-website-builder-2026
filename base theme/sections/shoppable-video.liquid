<div class="section-background color-{{ color_scheme }}"></div>
<div
  class="
    section
    section--{{ section_width }}
    color-{{ color_scheme }}
    shoppable-video
    {% if use_theme_styles %}shoppable-video--theme{% endif %}
    spacing-style
    section-{{ section.id }}
    video-{{ section.id }}
  "
  {% if use_theme_styles %}
    style="{% render 'spacing-style', settings: section.settings %}"
  {% else %}
    style="background-color: {{ background_color }}; background-image: {{ background_gradient }};"
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="section-{{ section.id }}-settings">
    {% if heading != blank %}
      <div class="video-heading-{{ section.id }}">
        {% if use_theme_styles %}
          <div class="{{ heading_type_preset }} {{ heading_type_preset }} rte">{{ heading }}</div>
        {% else %}
          {{ heading }}
        {% endif %}
      </div>
    {% endif %}

    <div class="video-slider-{{ section.id }} swiper preview">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% assign block_product = block.settings.product %}
          {% assign block_variant = block_product.selected_or_first_available_variant %}
          <div class="video-slide-{{ section.id }} swiper-slide" {{ block.shopify_attributes }}>
            <div class="video-top-{{ section.id }}" data-shoppable-video-trigger data-slide-index="{{ forloop.index0 }}">
              {% assign video_id = block.settings.video.id | default: block.settings.video_url.id %}
