{% liquid
  assign strip_blocks = section.blocks | where: 'type', 'strip_item'
  assign mobile_layout = section.settings.mobile_layout | default: 'grid-2x2'
  assign padding_top_mobile = section.settings.padding-block-start-mobile | default: section.settings.padding-block-start | default: 24
  assign padding_bottom_mobile = section.settings.padding-block-end-mobile | default: section.settings.padding-block-end | default: 24
  assign show_border = section.settings.show_border
  assign show_dividers = section.settings.show_dividers
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --neeloos-strip-bg: {{ section.settings.strip_background }};
    --neeloos-strip-border: {{ section.settings.strip_border_color }};
    --neeloos-strip-radius: {{ section.settings.strip_border_radius }}px;
    --neeloos-strip-icon-color: {{ section.settings.icon_color }};
    --neeloos-strip-heading-color: {{ section.settings.heading_color }};
    --neeloos-strip-subtext-color: {{ section.settings.subtext_color }};
    --neeloos-strip-icon-size: {{ section.settings.icon_size | default: 44 }}px;
    --neeloos-strip-heading-size: {{ section.settings.heading_font_size | default: 15 }}px;
    --neeloos-strip-subtext-size: {{ section.settings.subtext_font_size | default: 13 }}px;
    --neeloos-strip-divider-inset: {{ section.settings.divider_inset | default: 18 }}px;
    --neeloos-strip-item-padding: {{ section.settings.item_padding | default: 28 }}px;
    --neeloos-strip-item-gap: {{ section.settings.item_gap | default: 14 }}px;
  }

  #shopify-section-{{ section.id }} .neeloos-strip.spacing-style {
    padding-bottom: var(--padding-block-end) !important;
    padding-top: var(--padding-block-start) !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --neeloos-strip-icon-size: {{ section.settings.icon_size_mobile | default: 40 }}px;
      --neeloos-strip-heading-size: {{ section.settings.heading_font_size_mobile | default: 14 }}px;
      --neeloos-strip-subtext-size: {{ section.settings.subtext_font_size_mobile | default: 12 }}px;
      --neeloos-strip-item-padding: {{ section.settings.item_padding_mobile | default: 20 }}px;
      --neeloos-strip-item-gap: {{ section.settings.item_gap_mobile | default: 12 }}px;
    }

    #shopify-section-{{ section.id }} .neeloos-strip.spacing-style {
      padding-bottom: var(--padding-block-end-mobile, var(--padding-block-end)) !important;
      padding-top: var(--padding-block-start-mobile, var(--padding-block-start)) !important;
    }
  }

  #shopify-section-{{ section.id }} .neeloos-strip__heading {
    font-size: var(--neeloos-strip-heading-size) !important;
  }

  #shopify-section-{{ section.id }} .neeloos-strip__subtext {
    font-size: var(--neeloos-strip-subtext-size) !important;
  }
{% endstyle %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    neeloos-strip
    neeloos-strip--mobile-{{ mobile_layout }}
    {% if show_border %}neeloos-strip--bordered{% endif %}
    {% if show_dividers %}neeloos-strip--divided{% endif %}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %} --padding-block-start-mobile: {{ padding_top_mobile }}px; --padding-block-end-mobile: {{ padding_bottom_mobile }}px;"
  {{ section.shopify_attributes }}
>
  <div class="neeloos-strip__inner">
    <div class="neeloos-strip__card" role="list" aria-label="{{ section.settings.accessibility_label | default: 'Product benefits' | escape }}">
      <div class="neeloos-strip__grid">
        {% if strip_blocks.size > 0 %}
          {% for block in strip_blocks %}
            <div class="neeloos-strip__item" role="listitem" {{ block.shopify_attributes }}>
              <span class="neeloos-strip__icon" aria-hidden="true">
                {% if block.settings.custom_icon != blank %}
                  {{
                    block.settings.custom_icon
                    | image_url: width: 96
                    | image_tag: class: 'neeloos-strip__icon-img', loading: 'lazy', alt: ''
                  }}
                {% else %}
                  {% render 'neeloos-strip-icon', icon: block.settings.icon %}
                {% endif %}
              </span>
              <div class="neeloos-strip__text">
                {% if block.settings.heading != blank %}
                  <p class="neeloos-strip__heading">{{ block.settings.heading }}</p>
                {% endif %}
                {% if block.settings.subtext != blank %}
                  <p class="neeloos-strip__subtext">{{ block.settings.subtext }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% assign default_headings = 'Doctor Formulated|Traditional Kerala Ingredients|Made in Small Batches|Safe & Gentle' | split: '|' %}
          {% assign default_subtexts = 'Backed by science & expertise|Rooted in our heritage|Fresh & carefully crafted|For your little ones' | split: '|' %}
          {% assign default_icons = 'doctor|sprig|pot|shield' | split: '|' %}
          {% for i in (0..3) %}
            <div class="neeloos-strip__item" role="listitem">
              <span class="neeloos-strip__icon" aria-hidden="true">
                {% render 'neeloos-strip-icon', icon: default_icons[i] %}
              </span>
              <div class="neeloos-strip__text">
                <p class="neeloos-strip__heading">{{ default_headings[i] }}</p>
                <p class="neeloos-strip__subtext">{{ default_subtexts[i] }}</p>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .neeloos-strip__inner {
    margin: 0 auto;
    max-width: 1280px;
    width: 100%;
  }

  .neeloos-strip__card {
    background: var(--neeloos-strip-bg);
    border-radius: var(--neeloos-strip-radius);
    box-sizing: border-box;
    overflow: hidden;
    width: 100%;
  }

  .neeloos-strip--bordered .neeloos-strip__card {
    border: 1px solid var(--neeloos-strip-border);
  }

  .neeloos-strip__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .neeloos-strip__item {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    gap: var(--neeloos-strip-item-gap);
    padding: var(--neeloos-strip-item-padding);
    position: relative;
  }

  @media screen and (min-width: 990px) {
    .neeloos-strip--divided .neeloos-strip__item:not(:first-child)::before {
      background: var(--neeloos-strip-border);
      bottom: var(--neeloos-strip-divider-inset);
      content: '';
      left: 0;
      position: absolute;
      top: var(--neeloos-strip-divider-inset);
      width: 1px;
    }
  }

  .neeloos-strip__icon {
    color: var(--neeloos-strip-icon-color);
    flex-shrink: 0;
    height: var(--neeloos-strip-icon-size);
    width: var(--neeloos-strip-icon-size);
  }

  .neeloos-strip__icon svg,
  .neeloos-strip__icon-img {
    display: block;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .neeloos-strip__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .neeloos-strip__heading {
    color: var(--neeloos-strip-heading-color);
    font-size: var(--neeloos-strip-heading-size);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0;
  }

  .neeloos-strip__subtext {
    color: var(--neeloos-strip-subtext-color);
    font-size: var(--neeloos-strip-subtext-size);
    font-weight: 400;
    line-height: 1.45;
    margin: 0;
    opacity: 0.88;
  }

  @media screen and (min-width: 990px) {
    .neeloos-strip__item {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 989px) {
    .neeloos-strip--mobile-grid-2x2 .neeloos-strip__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .neeloos-strip--mobile-grid-2x2.neeloos-strip--divided .neeloos-strip__item:nth-child(odd):not(:first-child)::before,
    .neeloos-strip--mobile-grid-2x2.neeloos-strip--divided .neeloos-strip__item:nth-child(even)::before {
      background: var(--neeloos-strip-border);
      bottom: var(--neeloos-strip-divider-inset);
      content: '';
      left: 0;
      position: absolute;
      top: var(--neeloos-strip-divider-inset);
      width: 1px;
    }

    .neeloos-strip--mobile-grid-2x2.neeloos-strip--divided .neeloos-strip__item:nth-child(n + 3) {
      border-top: 1px solid var(--neeloos-strip-border);
    }

    .neeloos-strip--mobile-column-1 .neeloos-strip__grid {
      grid-template-columns: 1fr;
    }

    .neeloos-strip--mobile-column-1.neeloos-strip--divided .neeloos-strip__item:not(:first-child) {
      border-top: 1px solid var(--neeloos-strip-border);
    }

    .neeloos-strip--mobile-column-1 .neeloos-strip__item::before {
      display: none;
    }

    .neeloos-strip--mobile-scroll .neeloos-strip__card {
      border-radius: var(--neeloos-strip-radius);
      overflow: visible;
    }

    .neeloos-strip--mobile-scroll .neeloos-strip__grid {
      display: flex;
      gap: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      touch-action: pan-x;
    }

    .neeloos-strip--mobile-scroll .neeloos-strip__grid::-webkit-scrollbar {
      display: none;
    }

    .neeloos-strip--mobile-scroll .neeloos-strip__item {
      flex: 0 0 min(78vw, 280px);
      scroll-snap-align: start;
    }

    .neeloos-strip--mobile-scroll .neeloos-strip__item::before {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .neeloos-strip {
      box-sizing: border-box;
      max-width: 100%;
      overflow-x: clip;
      width: 100%;
    }

    .neeloos-strip__inner {
      max-width: 100%;
      padding-inline: var(--page-margin, 16px);
    }

    .neeloos-strip--mobile-scroll .neeloos-strip__inner {
      padding-inline: 0;
    }

    .neeloos-strip--mobile-scroll .neeloos-strip__card {
      margin-inline: var(--page-margin, 16px);
    }

    .neeloos-strip--mobile-scroll .neeloos-strip__grid {
      padding-inline: var(--page-margin, 16px);
      scroll-padding-inline: var(--page-margin, 16px);
    }

    .neeloos-strip__item {
      min-width: 0;
      padding: var(--neeloos-strip-item-padding);
    }

    .neeloos-strip__text {
      min-width: 0;
    }

    .neeloos-strip__heading {
      hyphens: auto;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    .neeloos-strip__subtext {
      line-height: 1.35;
      overflow-wrap: anywhere;
    }

    .neeloos-strip--mobile-grid-2x2 .neeloos-strip__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .neeloos-strip--mobile-grid-2x2 .neeloos-strip__item {
      align-items: flex-start;
      padding: 16px 14px;
    }

    .neeloos-strip--mobile-grid-2x2 .neeloos-strip__item:nth-child(n + 3) {
      border-top: 1px solid color-mix(in srgb, var(--neeloos-strip-border) 55%, transparent);
    }

    .neeloos-strip--mobile-grid-2x2 .neeloos-strip__item:nth-child(even) {
      border-left: 1px solid color-mix(in srgb, var(--neeloos-strip-border) 55%, transparent);
    }

    .neeloos-strip--mobile-grid-2x2 .neeloos-strip__heading {
      font-size: max(var(--neeloos-strip-heading-size), 0.75rem);
      line-height: 1.2;
    }

    .neeloos-strip--mobile-grid-2x2 .neeloos-strip__subtext {
      font-size: max(var(--neeloos-strip-subtext-size), 0.6875rem);
      line-height: 1.3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Neeloos Strip",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "header",
      "content": "Strip style"
    },
    {
      "type": "color",
      "id": "strip_background",
      "label": "Strip background",
      "default": "#fdf8f3"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show column dividers",
      "default": false
    },
    {
      "type": "color",
      "id": "strip_border_color",
      "label": "Border & divider color",
      "default": "#ebe4d8"
    },
    {
      "type": "range",
      "id": "strip_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "divider_inset",
      "label": "Divider inset",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18,
      "info": "Shortens vertical dividers so they do not touch the top and bottom edges."
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Product benefits",
      "info": "Describes this row for screen readers."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#5c4a3a"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#3d2e26"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#7a6b5e"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading size (mobile)",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "subtext_font_size",
      "label": "Subtext size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "subtext_font_size_mobile",
      "label": "Subtext size (mobile)",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Icons & spacing"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 28,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon size (mobile)",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Icon to text gap",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "item_gap_mobile",
      "label": "Icon to text gap (mobile)",
      "min": 8,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Item padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "item_padding_mobile",
      "label": "Item padding (mobile)",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "grid-2x2", "label": "2×2 grid (recommended)" },
        { "value": "scroll", "label": "Horizontal scroll" },
        { "value": "column-1", "label": "Single column" }
      ],
      "default": "grid-2x2"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "strip_item",
      "name": "Strip item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "doctor", "label": "Doctor formulated" },
            { "value": "sprig", "label": "Heritage ingredients" },
            { "value": "pot", "label": "Small batches" },
            { "value": "shield", "label": "Safe & gentle" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "doctor"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Overrides the selected icon above."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Doctor Formulated"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Backed by science & expertise"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Neeloos Strip",
      "category": "Content",
      "settings": {
        "strip_background": "#fdf8f3",
        "show_border": false,
        "show_dividers": false,
        "strip_border_color": "#ebe4d8",
        "strip_border_radius": 20,
        "divider_inset": 18,
        "icon_color": "#5c4a3a",
        "heading_color": "#3d2e26",
        "subtext_color": "#7a6b5e",
        "heading_font_size": 15,
        "heading_font_size_mobile": 14,
        "subtext_font_size": 13,
        "subtext_font_size_mobile": 12,
        "icon_size": 44,
        "icon_size_mobile": 40,
        "item_gap": 14,
        "item_gap_mobile": 12,
        "item_padding": 28,
        "item_padding_mobile": 20,
        "mobile_layout": "grid-2x2",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 24,
        "padding-block-end": 24,
        "padding-block-start-mobile": 16,
        "padding-block-end-mobile": 16
      },
      "blocks": [
        {
          "type": "strip_item",
          "settings": {
            "icon": "doctor",
            "heading": "Doctor Formulated",
            "subtext": "Backed by science & expertise"
          }
        },
        {
          "type": "strip_item",
          "settings": {
            "icon": "sprig",
            "heading": "Traditional Kerala Ingredients",
            "subtext": "Rooted in our heritage"
          }
        },
        {
          "type": "strip_item",
          "settings": {
            "icon": "pot",
            "heading": "Made in Small Batches",
            "subtext": "Fresh & carefully crafted"
          }
        },
        {
          "type": "strip_item",
          "settings": {
            "icon": "shield",
            "heading": "Safe & Gentle",
            "subtext": "For your little ones"
          }
        }
      ]
    }
  ]
}
{% endschema %}
