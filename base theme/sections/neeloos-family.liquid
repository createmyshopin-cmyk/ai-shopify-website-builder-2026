{%- liquid
  assign raw_business_number = section.settings.whatsapp_number | default: '' | strip
  assign business_digits = raw_business_number | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', ''

  if business_digits contains '+'
    assign business_digits = business_digits | remove: '+'
  endif

  assign padding_top_mobile = section.settings.padding-block-start-mobile | default: section.settings.padding-block-start | default: 32
  assign padding_bottom_mobile = section.settings.padding-block-end-mobile | default: section.settings.padding-block-end | default: 32
  assign default_message = section.settings.whatsapp_message | default: "Hi! I'd like to join the Neeloos Family. My WhatsApp number is: {phone}." | strip
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --neeloos-family-bg: {{ section.settings.card_background }};
    --neeloos-family-border: {{ section.settings.card_border_color }};
    --neeloos-family-radius: {{ section.settings.card_border_radius }}px;
    --neeloos-family-icon-color: {{ section.settings.icon_color }};
    --neeloos-family-heading-color: {{ section.settings.heading_color }};
    --neeloos-family-subtext-color: {{ section.settings.subtext_color }};
    --neeloos-family-leaf-color: {{ section.settings.leaf_color }};
    --neeloos-family-input-bg: {{ section.settings.input_background }};
    --neeloos-family-input-border: {{ section.settings.input_border_color }};
    --neeloos-family-input-text: {{ section.settings.input_text_color }};
    --neeloos-family-input-placeholder: {{ section.settings.input_placeholder_color }};
    --neeloos-family-btn-bg: {{ section.settings.button_background }};
    --neeloos-family-btn-text: {{ section.settings.button_text_color }};
    --neeloos-family-btn-hover: {{ section.settings.button_hover_background }};
    --neeloos-family-success-bg: {{ section.settings.success_popup_background }};
    --neeloos-family-success-tick: {{ section.settings.success_tick_color }};
    --neeloos-family-heading-size: {{ section.settings.heading_font_size | default: 22 }}px;
    --neeloos-family-subtext-size: {{ section.settings.subtext_font_size | default: 14 }}px;
    --neeloos-family-icon-size: {{ section.settings.icon_size | default: 44 }}px;
    --neeloos-family-card-padding: {{ section.settings.card_padding | default: 28 }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --neeloos-family-heading-size: {{ section.settings.heading_font_size_mobile | default: 20 }}px;
      --neeloos-family-subtext-size: {{ section.settings.subtext_font_size_mobile | default: 13 }}px;
      --neeloos-family-icon-size: {{ section.settings.icon_size_mobile | default: 36 }}px;
      --neeloos-family-card-padding: {{ section.settings.card_padding_mobile | default: 20 }}px;
    }

    #shopify-section-{{ section.id }} .neeloos-family.spacing-style {
      padding-bottom: var(--padding-block-end-mobile, var(--padding-block-end)) !important;
      padding-top: var(--padding-block-start-mobile, var(--padding-block-start)) !important;
    }
  }

  #shopify-section-{{ section.id }} .neeloos-family__heading {
    font-size: var(--neeloos-family-heading-size) !important;
  }

  #shopify-section-{{ section.id }} .neeloos-family__subtext {
    font-size: var(--neeloos-family-subtext-size) !important;
  }
{% endstyle %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    neeloos-family
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %} --padding-block-start-mobile: {{ padding_top_mobile }}px; --padding-block-end-mobile: {{ padding_bottom_mobile }}px;"
  {{ section.shopify_attributes }}
>
  <div class="neeloos-family__inner">
    <div class="neeloos-family__card">
      <div class="neeloos-family__layout">
        <div class="neeloos-family__brand">
          <span class="neeloos-family__icon" aria-hidden="true">
            {% if section.settings.custom_icon != blank %}
              {{
                section.settings.custom_icon
                | image_url: width: 96
                | image_tag: class: 'neeloos-family__icon-img', loading: 'lazy', alt: ''
              }}
            {% else %}
              <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 34c2-8 8-14 16-14s14 6 16 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M14 34h20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M16 34v-3c0-2 2-4 4-4h8c2 0 4 2 4 4v3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M22 18c-1-3 0-6 2-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M26 18c1-3 0-6-2-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="24" cy="14" r="3" stroke="currentColor" stroke-width="1.5"/>
                <path d="M20 10c-2-1-4-1-6 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M28 10c2-1 4-1 6 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            {% endif %}
          </span>

          <div class="neeloos-family__copy">
            {% if section.settings.heading != blank %}
              <h2 class="neeloos-family__heading">{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.subtext != blank %}
              <p class="neeloos-family__subtext">{{ section.settings.subtext }}</p>
            {% endif %}
          </div>
        </div>

        <neeloos-family-form
          class="neeloos-family__form-wrap"
          data-business-number="{{ business_digits }}"
          data-message-template="{{ default_message | escape }}"
          data-country-code="{{ section.settings.default_country_code | default: '91' | escape }}"
          data-success-title="{{ section.settings.success_message | default: 'Thank You!' | escape }}"
          data-success-subtext="{{ section.settings.success_subtext | default: 'You are now part of the Neeloos Family.' | escape }}"
          data-open-whatsapp="{% if section.settings.open_whatsapp_on_submit %}true{% else %}false{% endif %}"
          data-gas-enabled="{% if section.settings.enable_google_apps_script %}true{% else %}false{% endif %}"
          data-gas-url="{{ section.settings.google_apps_script_url | strip | escape }}"
          data-gas-token="{{ section.settings.google_apps_script_token | strip | escape }}"
          data-source="{{ section.settings.form_source_label | default: 'Neeloos Family' | escape }}"
        >
          <form class="neeloos-family__form" novalidate>
            <div class="neeloos-family__input-group">
              <div class="neeloos-family__field">
                {% if section.settings.show_country_code %}
                  <span class="neeloos-family__prefix" aria-hidden="true">+{{ section.settings.default_country_code | default: '91' }}</span>
                {% endif %}
                <input
                  type="tel"
                  name="phone"
                  class="neeloos-family__input"
                  inputmode="tel"
                  autocomplete="tel"
                  autocorrect="off"
                  autocapitalize="off"
                  placeholder="{{ section.settings.phone_placeholder | default: 'Enter your WhatsApp number' }}"
                  aria-label="{{ section.settings.phone_placeholder | default: 'Enter your WhatsApp number' | escape }}"
                  required
                  data-neeloos-family-input
                >
              </div>
              <button type="submit" class="neeloos-family__button">
                {{ section.settings.button_label | default: 'Subscribe' }}
              </button>
            </div>

            <p class="neeloos-family__feedback neeloos-family__feedback--error" data-neeloos-family-error hidden></p>
          </form>

          <div class="neeloos-family__popup" data-neeloos-family-popup hidden aria-hidden="true">
            <div class="neeloos-family__popup-backdrop" data-neeloos-family-popup-close></div>
            <div
              class="neeloos-family__popup-card"
              role="dialog"
              aria-modal="true"
              aria-labelledby="neeloos-family-popup-title-{{ section.id }}"
            >
               <button type="button" class="neeloos-family__popup-close" data-neeloos-family-popup-close aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                </svg>
              </button>
              <div class="neeloos-family__popup-tick" aria-hidden="true">
                <svg class="neeloos-family__popup-tick-svg" viewBox="0 0 72 72" fill="none">
                  <circle class="neeloos-family__popup-circle" cx="36" cy="36" r="32" stroke="currentColor" stroke-width="3"/>
                  <path class="neeloos-family__popup-check" d="M22 37l10 10 18-20" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <h3 class="neeloos-family__popup-title" id="neeloos-family-popup-title-{{ section.id }}" data-neeloos-family-popup-title>
                {{ section.settings.success_message | default: 'Thank You!' }}
              </h3>
              <p class="neeloos-family__popup-subtext" data-neeloos-family-popup-subtext>
                {{ section.settings.success_subtext | default: 'You are now part of the Neeloos Family.' }}
              </p>
            </div>
          </div>
        </neeloos-family-form>

        {% if section.settings.show_leaf_decoration %}
          <span class="neeloos-family__leaf" aria-hidden="true">
            <svg viewBox="0 0 80 120" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M40 110V45" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M40 78C28 72 18 58 14 40" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M40 62C52 56 62 42 66 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M40 50C34 38 32 24 34 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M22 52c8 4 16 10 24 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M58 44c-8 4-16 10-24 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .neeloos-family__inner {
    margin: 0 auto;
    max-width: 1280px;
    width: 100%;
  }

  .neeloos-family__card {
    background: var(--neeloos-family-bg);
    border: 1px solid var(--neeloos-family-border);
    border-radius: var(--neeloos-family-radius);
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .neeloos-family__layout {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    gap: 24px;
    padding: var(--neeloos-family-card-padding);
    position: relative;
  }

  .neeloos-family__brand {
    align-items: center;
    display: flex;
    flex: 1 1 auto;
    gap: 16px;
    min-width: 0;
  }

  .neeloos-family__icon {
    color: var(--neeloos-family-icon-color);
    flex-shrink: 0;
    height: var(--neeloos-family-icon-size);
    width: var(--neeloos-family-icon-size);
  }

  .neeloos-family__icon svg,
  .neeloos-family__icon-img {
    display: block;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .neeloos-family__copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .neeloos-family__heading {
    color: var(--neeloos-family-heading-color);
    font-family: var(--font-heading--family, inherit);
    font-size: var(--neeloos-family-heading-size);
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
  }

  .neeloos-family__subtext {
    color: var(--neeloos-family-subtext-color);
    font-family: var(--font-body--family, inherit);
    font-size: var(--neeloos-family-subtext-size);
    font-weight: 400;
    line-height: 1.45;
    margin: 0;
  }

  .neeloos-family__form-wrap {
    display: block;
    flex: 0 1 420px;
    max-width: 420px;
    min-width: 0;
    width: 100%;
  }

  .neeloos-family__form {
    margin: 0;
    width: 100%;
  }

  .neeloos-family__input-group {
    align-items: stretch;
    background: var(--neeloos-family-input-bg);
    border: 1px solid var(--neeloos-family-input-border);
    border-radius: 10px;
    display: flex;
    overflow: hidden;
    width: 100%;
  }

  .neeloos-family__field {
    align-items: center;
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
  }

  .neeloos-family__prefix {
    align-items: center;
    border-right: 1px solid var(--neeloos-family-input-border);
    color: var(--neeloos-family-subtext-color);
    display: flex;
    flex-shrink: 0;
    font-family: var(--font-body--family, inherit);
    font-size: 14px;
    font-weight: 500;
    padding-inline: 12px 8px;
    white-space: nowrap;
  }

  .neeloos-family__input {
    background: transparent;
    border: none;
    color: var(--neeloos-family-input-text);
    flex: 1 1 auto;
    font-family: var(--font-body--family, inherit);
    font-size: 14px;
    min-width: 0;
    outline: none;
    padding: 14px 12px;
    width: 100%;
  }

  .neeloos-family__input::placeholder {
    color: var(--neeloos-family-input-placeholder);
  }

  .neeloos-family__button {
    background: var(--neeloos-family-btn-bg);
    border: none;
    border-radius: 0 8px 8px 0;
    color: var(--neeloos-family-btn-text);
    cursor: pointer;
    flex-shrink: 0;
    font-family: var(--font-body--family, inherit);
    font-size: 14px;
    font-weight: 600;
    padding: 14px 22px;
    transition: background-color 0.2s ease;
    white-space: nowrap;
  }

  .neeloos-family__button:hover {
    background: var(--neeloos-family-btn-hover);
  }

  .neeloos-family__button.is-loading {
    cursor: wait;
    opacity: 0.85;
    pointer-events: none;
  }

  .neeloos-family__feedback {
    font-size: 13px;
    line-height: 1.4;
    margin: 8px 0 0;
  }

  .neeloos-family__feedback--error {
    color: #c0392b;
  }

  .neeloos-family__popup {
    align-items: center;
    display: flex;
    inset: 0;
    justify-content: center;
    padding: 20px;
    position: fixed;
    z-index: 9999;
  }

  .neeloos-family__popup[hidden] {
    display: none;
  }

  .neeloos-family__popup.is-visible {
    animation: neeloos-family-popup-fade-in 0.25s ease forwards;
  }

  .neeloos-family__popup-backdrop {
    background: rgba(43, 33, 27, 0.45);
    inset: 0;
    position: absolute;
  }

  .neeloos-family__popup-card {
    animation: neeloos-family-popup-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    background: var(--neeloos-family-success-bg, #faf8f5);
    border: 1px solid var(--neeloos-family-border);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(43, 33, 27, 0.18);
    box-sizing: border-box;
    max-width: 360px;
    padding: 36px 28px 32px;
    position: relative;
    text-align: center;
    transform: scale(0.82);
    width: 100%;
    z-index: 1;
  }

  .neeloos-family__popup-close {
    align-items: center;
    background: transparent;
    border: none;
    color: var(--neeloos-family-subtext-color);
    cursor: pointer;
    display: flex;
    height: 32px;
    justify-content: center;
    padding: 0;
    position: absolute;
    right: 12px;
    top: 12px;
    width: 32px;
  }

  .neeloos-family__popup-close svg {
    height: 18px;
    width: 18px;
  }

  .neeloos-family__popup-tick {
    color: var(--neeloos-family-success-tick, #6b8f4e);
    height: 72px;
    margin: 0 auto 18px;
    width: 72px;
  }

  .neeloos-family__popup-tick-svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  .neeloos-family__popup-circle {
    stroke-dasharray: 201;
    stroke-dashoffset: 201;
    animation: neeloos-family-draw-circle 0.55s ease forwards 0.1s;
    transform-origin: center;
  }

  .neeloos-family__popup-check {
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    animation: neeloos-family-draw-check 0.35s ease forwards 0.55s;
  }

  .neeloos-family__popup-title {
    animation: neeloos-family-popup-text 0.4s ease forwards 0.65s;
    color: var(--neeloos-family-heading-color);
    font-family: var(--font-heading--family, inherit);
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 8px;
    opacity: 0;
    transform: translateY(8px);
  }

  .neeloos-family__popup-subtext {
    animation: neeloos-family-popup-text 0.4s ease forwards 0.78s;
    color: var(--neeloos-family-subtext-color);
    font-family: var(--font-body--family, inherit);
    font-size: 0.9375rem;
    line-height: 1.45;
    margin: 0;
    opacity: 0;
    transform: translateY(8px);
  }

  @keyframes neeloos-family-popup-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes neeloos-family-popup-pop {
    from {
      opacity: 0;
      transform: scale(0.82);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes neeloos-family-draw-circle {
    to { stroke-dashoffset: 0; }
  }

  @keyframes neeloos-family-draw-check {
    to { stroke-dashoffset: 0; }
  }

  @keyframes neeloos-family-popup-text {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .neeloos-family__leaf {
    bottom: 0;
    color: var(--neeloos-family-leaf-color);
    height: 88px;
    opacity: 0.55;
    pointer-events: none;
    position: absolute;
    right: 0;
    width: 56px;
  }

  .neeloos-family__leaf svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  @media screen and (max-width: 989px) {
    .neeloos-family__layout {
      align-items: stretch;
      flex-direction: column;
      gap: 20px;
    }

    .neeloos-family__form-wrap {
      flex: 1 1 auto;
      max-width: none;
      width: 100%;
    }

    .neeloos-family__leaf {
      height: 72px;
      opacity: 0.35;
      width: 48px;
    }
  }

  @media screen and (max-width: 749px) {
    .neeloos-family {
      box-sizing: border-box;
      max-width: 100%;
      overflow-x: clip;
      width: 100%;
    }

    .neeloos-family__inner {
      max-width: 100%;
      padding-inline: var(--page-margin, 16px);
    }

    .neeloos-family__layout {
      gap: 18px;
      padding: var(--neeloos-family-card-padding);
    }

    .neeloos-family__brand {
      align-items: flex-start;
      gap: 12px;
    }

    .neeloos-family__icon {
      margin-top: 2px;
    }

    .neeloos-family__copy {
      gap: 6px;
    }

    .neeloos-family__heading {
      line-height: 1.2;
    }

    .neeloos-family__subtext {
      line-height: 1.5;
    }

    .neeloos-family__form-wrap {
      width: 100%;
    }

    .neeloos-family__input-group {
      background: transparent;
      border: none;
      border-radius: 0;
      flex-direction: column;
      gap: 0;
      overflow: visible;
    }

    .neeloos-family__field {
      align-items: stretch;
      background: var(--neeloos-family-input-bg);
      border: 1px solid var(--neeloos-family-input-border);
      border-bottom: none;
      border-radius: 12px 12px 0 0;
      flex-direction: column;
      gap: 0;
      padding: 14px 16px 10px;
    }

    .neeloos-family__prefix {
      border-right: none;
      color: var(--neeloos-family-input-text);
      font-size: 15px;
      font-weight: 600;
      line-height: 1;
      padding: 0 0 8px;
      width: auto;
    }

    .neeloos-family__input {
      flex: none;
      font-size: 16px;
      line-height: 1.4;
      padding: 0;
    }

    .neeloos-family__input::placeholder {
      font-size: 15px;
    }

    .neeloos-family__button {
      border-radius: 0 0 12px 12px;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.01em;
      min-height: 52px;
      padding: 16px 20px;
      width: 100%;
    }

    .neeloos-family__button:active {
      transform: scale(0.99);
    }

    .neeloos-family__feedback {
      font-size: 14px;
      margin-top: 10px;
      text-align: center;
    }

    .neeloos-family__leaf {
      height: 64px;
      opacity: 0.28;
      right: -4px;
      width: 44px;
    }

    .neeloos-family__popup {
      padding: 16px;
    }

    .neeloos-family__popup-card {
      border-radius: 18px;
      max-width: min(340px, 100%);
      padding: 32px 22px 28px;
    }

    .neeloos-family__popup-title {
      font-size: 1.5rem;
    }

    .neeloos-family__popup-subtext {
      font-size: 0.875rem;
    }
  }

  @media screen and (max-width: 389px) {
    .neeloos-family__brand {
      gap: 10px;
    }

    .neeloos-family__heading {
      font-size: calc(var(--neeloos-family-heading-size) - 1px) !important;
    }
  }
{% endstylesheet %}

<script>
  if (!customElements.get('neeloos-family-form')) {
    class NeeloosFamilyForm extends HTMLElement {
      connectedCallback() {
        this.form = this.querySelector('form');
        this.input = this.querySelector('[data-neeloos-family-input]');
        this.button = this.querySelector('.neeloos-family__button');
        this.errorEl = this.querySelector('[data-neeloos-family-error]');
        this.popup = this.querySelector('[data-neeloos-family-popup]');
        this.popupTitle = this.querySelector('[data-neeloos-family-popup-title]');
        this.popupSubtext = this.querySelector('[data-neeloos-family-popup-subtext]');
        this.popupCloseEls = this.querySelectorAll('[data-neeloos-family-popup-close]');
        this.popupTimer = null;

        if (!this.form || !this.input) return;

        this.handleSubmit = this.onSubmit.bind(this);
        this.handleKeydown = this.onKeydown.bind(this);
        this.form.addEventListener('submit', this.handleSubmit);

        this.popupCloseEls.forEach(function (el) {
          el.addEventListener('click', this.closePopup.bind(this));
        }, this);

        document.addEventListener('keydown', this.handleKeydown);
      }

      disconnectedCallback() {
        document.removeEventListener('keydown', this.handleKeydown);
        if (this.popupTimer) window.clearTimeout(this.popupTimer);
      }

      onKeydown(event) {
        if (event.key === 'Escape' && this.popup && !this.popup.hidden) {
          this.closePopup();
        }
      }

      sanitizePhone(value) {
        return String(value || '')
          .replace(/[^\d+]/g, '')
          .replace(/^\+/, '');
      }

      buildFullNumber(digits) {
        const countryCode = this.dataset.countryCode || '';
        if (!digits) return '';

        if (countryCode && digits.startsWith(countryCode) && digits.length > countryCode.length + 6) {
          return digits;
        }

        return countryCode + digits.replace(/^0+/, '');
      }

      onSubmit(event) {
        event.preventDefault();

        const businessNumber = this.sanitizePhone(this.dataset.businessNumber || '');
        const rawInput = this.input.value.trim();
        const digits = this.sanitizePhone(rawInput);
        const fullNumber = this.buildFullNumber(digits);
        const gasEnabled = this.dataset.gasEnabled === 'true';
        const gasUrl = (this.dataset.gasUrl || '').trim();
        const openWhatsapp = this.dataset.openWhatsapp === 'true';

        this.hideFeedback();

        if (!fullNumber || fullNumber.length < 8) {
          this.showError('Please enter a valid WhatsApp number.');
          return;
        }

        if (gasEnabled && !gasUrl) {
          this.showError('Google Apps Script URL is not configured.');
          return;
        }

        if (!gasEnabled && openWhatsapp && !businessNumber) {
          this.showError('WhatsApp number is not configured for this section.');
          return;
        }

        const template =
          this.dataset.messageTemplate ||
          "Hi! I'd like to join the Neeloos Family. My WhatsApp number is: {phone}.";
        const message = template.replace(/\{phone\}/g, '+' + fullNumber);
        const waUrl = 'https://wa.me/' + businessNumber + '?text=' + encodeURIComponent(message);

        this.input.value = '+' + fullNumber;

        if (this.button) this.button.classList.add('is-loading');

        const requests = [];

        if (gasEnabled && gasUrl) {
          requests.push(this.sendToGoogleAppsScript(gasUrl, fullNumber));
        }

        Promise.allSettled(requests.length ? requests : [Promise.resolve()])
          .finally(
            function () {
              if (this.button) this.button.classList.remove('is-loading');
              this.showSuccessPopup();
              this.form.reset();

              if (openWhatsapp && businessNumber) {
                window.open(waUrl, '_blank', 'noopener,noreferrer');
              }
            }.bind(this)
          );
      }

      sendToGoogleAppsScript(gasUrl, fullNumber) {
        const payload = {
          phone: '+' + fullNumber,
          source: this.dataset.source || 'Neeloos Family',
          pageUrl: window.location.href,
          submittedAt: new Date().toISOString(),
          token: this.dataset.gasToken || '',
        };

        return fetch(gasUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        }).catch(function () {});
      }

      hideFeedback() {
        if (this.errorEl) this.errorEl.hidden = true;
      }

      showError(message) {
        if (!this.errorEl) return;
        this.errorEl.textContent = message;
        this.errorEl.hidden = false;
      }

      showSuccessPopup() {
        if (!this.popup) return;

        if (this.popupTitle && this.dataset.successTitle) {
          this.popupTitle.textContent = this.dataset.successTitle;
        }

        if (this.popupSubtext && this.dataset.successSubtext) {
          this.popupSubtext.textContent = this.dataset.successSubtext;
        }

        this.popup.hidden = false;
        this.popup.setAttribute('aria-hidden', 'false');
        this.popup.classList.remove('is-visible');
        void this.popup.offsetWidth;
        this.popup.classList.add('is-visible');

        this.restartTickAnimation();

        if (this.popupTimer) window.clearTimeout(this.popupTimer);
        this.popupTimer = window.setTimeout(this.closePopup.bind(this), 4500);
      }

      restartTickAnimation() {
        const circle = this.querySelector('.neeloos-family__popup-circle');
        const check = this.querySelector('.neeloos-family__popup-check');
        const title = this.querySelector('.neeloos-family__popup-title');
        const subtext = this.querySelector('.neeloos-family__popup-subtext');

        [circle, check, title, subtext].forEach(function (el) {
          if (!el) return;
          el.style.animation = 'none';
          void el.offsetWidth;
          el.style.animation = '';
        });
      }

      closePopup() {
        if (!this.popup || this.popup.hidden) return;

        this.popup.hidden = true;
        this.popup.setAttribute('aria-hidden', 'true');
        this.popup.classList.remove('is-visible');

        if (this.popupTimer) {
          window.clearTimeout(this.popupTimer);
          this.popupTimer = null;
        }
      }
    }

    customElements.define('neeloos-family-form', NeeloosFamilyForm);
  }
</script>

