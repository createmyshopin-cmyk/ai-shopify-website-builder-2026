{% liquid
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign mobile_feature_layout = section.settings.mobile_feature_layout | default: 'row-4'
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --neeloos-bg: {{ section.settings.background_color }};
    --neeloos-eyebrow-color: {{ section.settings.eyebrow_color }};
    --neeloos-heading-color: {{ section.settings.heading_color }};
    --neeloos-body-color: {{ section.settings.body_color }};
    --neeloos-accent: {{ section.settings.accent_color }};
    --neeloos-feature-color: {{ section.settings.feature_text_color }};
    --neeloos-image-radius: {{ section.settings.image_border_radius }}px;
    --neeloos-heading-size: {{ section.settings.heading_font_size }}px;
    --neeloos-body-size: {{ section.settings.body_font_size }}px;
    --neeloos-grid-gap: {{ section.settings.column_gap }}px;
    --neeloos-feature-icon-size: 52px;
    --neeloos-feature-text-size: 0.8125rem;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      --neeloos-feature-icon-size: 46px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --neeloos-heading-size: {{ section.settings.heading_font_size_mobile }}px;
      --neeloos-body-size: {{ section.settings.body_font_size_mobile }}px;
      --neeloos-grid-gap: {{ section.settings.column_gap_mobile }}px;
      --neeloos-image-radius: {{ section.settings.image_border_radius_mobile }}px;
      --neeloos-feature-icon-size: {{ section.settings.mobile_feature_icon_size }}px;
      --neeloos-feature-text-size: {{ section.settings.mobile_feature_text_size | divided_by: 16.0 }}rem;
      --neeloos-mobile-inline: {{ section.settings.mobile_content_padding }}px;
      --neeloos-mobile-image-offset: {{ section.settings.mobile_image_offset }}px;
    }
  }

  #shopify-section-{{ section.id }} .neeloos__heading,
  #shopify-section-{{ section.id }} h2.neeloos__heading {
    font-size: var(--neeloos-heading-size) !important;
  }

  #shopify-section-{{ section.id }} .neeloos__body {
    font-size: var(--neeloos-body-size) !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .neeloos__grid {
      box-sizing: border-box;
      max-width: 100%;
      padding-inline: var(--neeloos-mobile-inline);
      width: 100%;
    }

    #shopify-section-{{ section.id }} .neeloos__media-wrap {
      box-sizing: border-box;
      display: flex;
      justify-content: center;
      order: 2;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .neeloos__media {
      align-self: center;
      aspect-ratio: 3 / 2;
      border-radius: var(--neeloos-image-radius) !important;
      box-sizing: border-box;
      display: block;
      flex: 0 1 100%;
      height: auto;
      margin-inline: auto !important;
      max-height: none;
      max-width: 100%;
      min-height: 0 !important;
      transform: translateX(var(--neeloos-mobile-image-offset));
      width: 100% !important;
    }

    #shopify-section-{{ section.id }} .neeloos__image,
    #shopify-section-{{ section.id }} .neeloos__image--placeholder {
      border-radius: inherit;
      display: block;
      height: 100%;
      min-height: 0 !important;
      object-fit: cover;
      width: 100%;
    }
  }
{% endstyle %}

<div
  class="neeloos neeloos--mobile-features-{{ mobile_feature_layout }} section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %} --color-background: var(--neeloos-bg); background: var(--neeloos-bg); --padding-block-start-mobile: {{ section.settings.padding-block-start-mobile }}px; --padding-block-end-mobile: {{ section.settings.padding-block-end-mobile }}px;"
  {{ section.shopify_attributes }}
>
  <div class="neeloos__inner">
    <div class="neeloos__grid">
      <div class="neeloos__media-wrap">
        <div class="neeloos__media" data-forge-slot-id="image"{% if section.settings.image == blank %} data-forge-slot-blank="true"{% endif %}>
          {% if section.settings.image != blank %}
            {%- capture sizes -%}
              (min-width: 990px) 38vw, (min-width: 750px) 45vw, 100vw
            {%- endcapture -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                class: 'neeloos__image',
                loading: 'lazy',
                widths: '375, 550, 750, 900, 1100, 1200',
                sizes: sizes,
                alt: section.settings.image.alt | default: section.settings.heading
            }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'neeloos__image neeloos__image--placeholder' }}
          {% endif %}
        </div>
      </div>

      <div class="neeloos__content">
        <div class="neeloos__intro">
          {% if section.settings.eyebrow != blank %}
            <p class="neeloos__eyebrow">
              <span>{{ section.settings.eyebrow }}</span>
              {% if section.settings.show_leaf_icon %}
                <span class="neeloos__eyebrow-leaf" aria-hidden="true">
                  <svg viewBox="0 0 42 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 19C10 19 5 13 3 5c8 0 15 3 18 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M24 16C25 8 31 3 39 2c-1 8-6 14-15 16" fill="currentColor" opacity=".75"/>
                    <path d="M7 12c9 2 18 7 27 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </span>
              {% endif %}
            </p>
          {% endif %}

          {% if section.settings.heading != blank %}
            {% assign heading_type_preset = section.settings.heading_type_preset | default: 'h2' %}
            <h2 class="neeloos__heading {{ heading_type_preset }} {{ heading_type_preset }}">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
        </div>

        <div class="neeloos__details">
          {% if section.settings.body != blank %}
            <div class="neeloos__body rte">{{ section.settings.body }}</div>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a
              href="{{ section.settings.button_link | default: '#' }}"
              class="neeloos__button"
            >
              <span>{{ section.settings.button_label }}</span>
              <span class="neeloos__button-arrow" aria-hidden="true">→</span>
            </a>
          {% endif %}
        </div>
      </div>

      {% if feature_blocks.size > 0 %}
        <ul class="neeloos__features">
          {% for block in feature_blocks %}
            <li class="neeloos__feature" {{ block.shopify_attributes }}>
              <span class="neeloos__feature-icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'pediatric' %}
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M24 14c-4 0-7 3-7 7v2c0 4 3 7 7 7s7-3 7-7v-2c0-4-3-7-7-7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                      <path d="M18 30c2 4 5 6 6 6s4-2 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M24 20v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M21 23h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {% when 'mother' %}
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="24" cy="16" r="4" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M16 34c1-5 4-8 8-8s7 3 8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <circle cx="32" cy="28" r="3" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M32 31v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {% when 'recipe' %}
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                      <ellipse cx="24" cy="27" rx="10" ry="5" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M14 27c0-5 4-9 10-9s10 4 10 9" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M30 16l4-3M30 20l5 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {% when 'batches' %}
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                      <rect x="14" y="20" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M18 20v-3c0-2 2-4 6-4s6 2 6 4v3" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M20 26h8M20 30h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {% else %}
                    {% if block.settings.custom_icon != blank %}
                      {{
                        block.settings.custom_icon
                        | image_url: width: 96
                        | image_tag: class: 'neeloos__feature-icon-img', loading: 'lazy', alt: ''
                      }}
                    {% else %}
                      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M16 24l5 5 11-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                {% endcase %}
              </span>
              {% if block.settings.text != blank %}
                <span class="neeloos__feature-text">{{ block.settings.text }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        {% assign default_features = '10+ Years of Pediatric Experience|Mother to a Little One|Every Recipe is Mom-Tested|Made in Small Batches' | split: '|' %}
        {% assign default_icons = 'pediatric|mother|recipe|batches' | split: '|' %}
        <ul class="neeloos__features">
          {% for i in (0..3) %}
            <li class="neeloos__feature">
              <span class="neeloos__feature-icon" aria-hidden="true">
                {% assign icon = default_icons[i] %}
                {% case icon %}
                  {% when 'pediatric' %}
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M24 14c-4 0-7 3-7 7v2c0 4 3 7 7 7s7-3 7-7v-2c0-4-3-7-7-7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                      <path d="M18 30c2 4 5 6 6 6s4-2 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M24 20v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M21 23h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {% when 'mother' %}
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="24" cy="16" r="4" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M16 34c1-5 4-8 8-8s7 3 8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <circle cx="32" cy="28" r="3" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M32 31v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {% when 'recipe' %}
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                      <ellipse cx="24" cy="27" rx="10" ry="5" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M14 27c0-5 4-9 10-9s10 4 10 9" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M30 16l4-3M30 20l5 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {% when 'batches' %}
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                      <rect x="14" y="20" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M18 20v-3c0-2 2-4 6-4s6 2 6 4v3" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M20 26h8M20 30h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                {% endcase %}
              </span>
              <span class="neeloos__feature-text">{{ default_features[i] }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .neeloos {
    position: relative;
    width: 100%;
  }

  .neeloos__inner {
    margin: 0 auto;
    max-width: 1320px;
    padding-inline: var(--page-margin, 24px);
  }

  .neeloos__grid {
    align-items: center;
    display: grid;
    gap: var(--neeloos-grid-gap);
    grid-template-columns: minmax(260px, 0.95fr) minmax(280px, 1.05fr) minmax(180px, 0.65fr);
  }

  .neeloos__media-wrap {
    display: contents;
  }

  .neeloos__media {
    align-self: stretch;
    border-radius: var(--neeloos-image-radius) 0 0 var(--neeloos-image-radius);
    min-height: 420px;
    overflow: hidden;
    position: relative;
  }

  .neeloos__image {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .neeloos__image--placeholder {
    background: rgb(43 33 27 / 0.06);
    height: 100%;
    min-height: 420px;
    object-fit: cover;
    width: 100%;
  }

  .neeloos__content {
    max-width: 36rem;
    padding-block: 12px;
  }

  .neeloos__intro {
    display: block;
  }

  .neeloos__details {
    display: block;
  }

  .neeloos__eyebrow {
    align-items: center;
    color: var(--neeloos-eyebrow-color);
    display: inline-flex;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 500;
    gap: 8px;
    letter-spacing: 0.02em;
    margin: 0 0 16px;
  }

  .neeloos__eyebrow-leaf {
    color: var(--neeloos-accent);
    display: inline-flex;
    height: 14px;
    width: 20px;
  }

  .neeloos__eyebrow-leaf svg {
    height: 100%;
    width: 100%;
  }

  .neeloos__heading {
    color: var(--neeloos-heading-color);
    font-family: var(--font-heading--family);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 20px;
  }

  .neeloos__body {
    color: var(--neeloos-body-color);
    font-family: var(--font-body--family);
    line-height: 1.65;
    margin-bottom: 28px;
    max-width: 42ch;
  }

  .neeloos__body p {
    margin: 0;
  }

  .neeloos__button {
    align-items: center;
    border: 1.5px solid var(--neeloos-accent);
    border-radius: 8px;
    color: var(--neeloos-accent);
    display: inline-flex;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 500;
    gap: 8px;
    padding: 12px 22px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .neeloos__button:hover {
    background: var(--neeloos-accent);
    color: #fff;
  }

  .neeloos__button-arrow {
    font-size: 1.1em;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .neeloos__button:hover .neeloos__button-arrow {
    transform: translateX(3px);
  }

  .neeloos__features {
    display: flex;
    flex-direction: column;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .neeloos__feature {
    align-items: center;
    display: flex;
    gap: 14px;
  }

  .neeloos__feature-icon {
    align-items: center;
    color: #b8845a;
    display: flex;
    flex-shrink: 0;
    height: var(--neeloos-feature-icon-size);
    justify-content: center;
    width: var(--neeloos-feature-icon-size);
  }

  .neeloos__feature-icon svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  .neeloos__feature-icon-img {
    display: block;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .neeloos__feature-text {
    color: var(--neeloos-feature-color);
    font-family: var(--font-body--family);
    font-size: var(--neeloos-feature-text-size);
    line-height: 1.4;
    max-width: 14ch;
  }

  @media screen and (max-width: 989px) {
    .neeloos__grid {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .neeloos__content {
      display: contents;
      max-width: none;
    }

    .neeloos__intro {
      order: 1;
    }

    .neeloos__media-wrap {
      display: flex;
      justify-content: center;
      order: 2;
      width: 100%;
    }

    .neeloos__media {
      align-self: center;
      aspect-ratio: 5 / 4;
      border-radius: var(--neeloos-image-radius);
      margin-inline: auto;
      max-height: none;
      max-width: 100%;
      min-height: 0;
      order: unset;
      width: 100%;
    }

    .neeloos__image--placeholder {
      min-height: 0;
    }

    .neeloos__image {
      object-position: center center;
    }

    .neeloos__details {
      order: 3;
    }

    .neeloos__body {
      max-width: none;
    }

    .neeloos__features {
      gap: 20px;
      order: 4;
    }
  }

  @media screen and (max-width: 749px) {
    .neeloos {
      box-sizing: border-box;
      max-width: 100%;
      overflow-x: clip;
      width: 100%;
    }

    .neeloos[class*='neeloos--mobile-features-'].spacing-style {
      padding-bottom: var(--padding-block-end-mobile) !important;
      padding-top: var(--padding-block-start-mobile) !important;
    }

    .neeloos__inner {
      max-width: 100%;
      padding-inline: 0;
      width: 100%;
    }

    .neeloos__grid {
      align-items: stretch;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      gap: var(--neeloos-grid-gap);
      padding-inline: var(--neeloos-mobile-inline);
      width: 100%;
    }

    .neeloos__content {
      display: contents;
      max-width: none;
      padding-block: 0;
    }

    .neeloos__intro {
      order: 1;
      padding-inline: 0;
    }

    .neeloos__media-wrap {
      display: flex;
      justify-content: center;
      order: 2;
      width: 100%;
    }

    .neeloos__media {
      align-self: center;
      aspect-ratio: 3 / 2;
      border-radius: var(--neeloos-image-radius);
      box-sizing: border-box;
      flex: 0 1 100%;
      height: auto;
      margin-inline: auto;
      max-height: none;
      max-width: 100%;
      min-height: 0;
      order: unset;
      transform: translateX(min(var(--neeloos-mobile-image-offset, 0px), 12px));
      width: 100%;
    }

    .neeloos__image,
    .neeloos__image--placeholder {
      border-radius: inherit;
      min-height: 0;
    }

    .neeloos__image {
      object-position: center center;
    }

    .neeloos__details {
      order: 3;
      padding-inline: 0;
    }

    .neeloos__eyebrow {
      font-size: 0.75rem;
      margin-bottom: 12px;
    }

    .neeloos__heading {
      line-height: 1.18;
      margin-bottom: 0;
    }

    .neeloos__body {
      line-height: 1.6;
      margin-bottom: 22px;
      max-width: none;
    }

    .neeloos__button {
      -webkit-tap-highlight-color: transparent;
      font-size: 0.9375rem;
      justify-content: center;
      min-height: 48px;
      padding: 14px 24px;
      touch-action: manipulation;
      width: 100%;
    }

    .neeloos__features {
      gap: 14px 12px;
      margin-top: 4px;
      order: 4;
      padding-inline: 0;
    }

    .neeloos--mobile-features-grid-2x2 .neeloos__features {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .neeloos--mobile-features-grid-2x2 .neeloos__feature {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
      min-height: 100%;
      text-align: left;
    }

    .neeloos--mobile-features-row-4 .neeloos__features {
      display: grid;
      gap: 8px;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .neeloos--mobile-features-row-4 .neeloos__feature {
      align-items: center;
      flex-direction: column;
      gap: 6px;
      text-align: center;
    }

    .neeloos--mobile-features-row-4 .neeloos__feature-icon {
      height: var(--neeloos-feature-icon-size);
      width: var(--neeloos-feature-icon-size);
    }

    .neeloos--mobile-features-row-4 .neeloos__feature-text {
      font-size: max(var(--neeloos-feature-text-size), 0.625rem);
      hyphens: auto;
      line-height: 1.25;
      overflow-wrap: anywhere;
      text-align: center;
    }

    .neeloos--mobile-features-column-1 .neeloos__features {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .neeloos--mobile-features-column-1 .neeloos__feature {
      align-items: center;
      gap: 12px;
    }

    .neeloos__feature-text {
      flex: 1;
      max-width: none;
    }

    .neeloos--mobile-features-grid-2x2 .neeloos__feature-text {
      font-size: calc(var(--neeloos-feature-text-size) - 0.0125rem);
      line-height: 1.35;
    }
  }

  @media screen and (max-width: 389px) {
    .neeloos--mobile-features-grid-2x2 .neeloos__features {
      gap: 12px 10px;
    }

    .neeloos--mobile-features-grid-2x2 .neeloos__feature {
      gap: 6px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Neeloos",
  "class": "ui-test-neeloos",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
