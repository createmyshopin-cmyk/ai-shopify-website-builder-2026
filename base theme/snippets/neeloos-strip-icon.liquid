{% doc %}
  Renders a line-art icon for the Neeloos Strip trust bar.
  @param {string} icon - Icon key: doctor, sprig, pot, shield, check
{% enddoc %}

{% case icon %}
  {% when 'doctor' %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="24" cy="16.5" r="5" stroke="currentColor" stroke-width="1.5"/>
      <path d="M17 14.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M19.5 12.5 24 9l4.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M14.5 33c1.5-6.5 4.5-9.5 9.5-9.5s8 3 9 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M29.5 22.5c2.5 0 4.5 2 4.5 4.5S32 31.5 29.5 31.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="29.5" cy="33.5" r="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M29.5 24.5v-1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {% when 'sprig' %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M24 38V20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M24 28C17.5 25.5 14 20.5 12.5 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M24 24C30.5 21.5 34 16.5 35.5 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M24 22C21 17.5 20 13 20.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <ellipse cx="12" cy="14" rx="3.5" ry="5" transform="rotate(-35 12 14)" stroke="currentColor" stroke-width="1.5"/>
      <ellipse cx="36" cy="10" rx="3.5" ry="5" transform="rotate(35 36 10)" stroke="currentColor" stroke-width="1.5"/>
      <ellipse cx="20" cy="9" rx="3" ry="4.5" transform="rotate(-10 20 9)" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  {% when 'pot' %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M18 12.5c0-1.5 2.5-2.5 6-2.5s6 1 6 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M17 12.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M15 18h18l-1.5 18H16.5L15 18z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M19 14v4M24 14v4M29 14v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M20 9.5c.5-1 1.5-1.5 2.5-1.5M28 9.5c-.5-1-1.5-1.5-2.5-1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {% when 'shield' %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M24 8 14 12v10c0 7.5 4.5 13 10 16 5.5-3 10-8.5 10-16V12L24 8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M24 20.5c-2 0-3.5 1.5-3.5 3.5 0 2.5 3.5 5 3.5 5s3.5-2.5 3.5-5c0-2-1.5-3.5-3.5-3.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  {% when 'pediatrician' %}
    {% render 'neeloos-strip-icon', icon: 'doctor' %}
  {% when 'sprout' %}
    {% render 'neeloos-strip-icon', icon: 'sprig' %}
  {% else %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="24" cy="24" r="14" stroke="currentColor" stroke-width="1.5"/>
      <path d="M16 24l5 5 11-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
{% endcase %}
