{%- doc -%}
  Wishlist toggle button for a product.

  @param {object} product - The product object
  @param {string} [class] - Additional CSS classes for the wrapper
{%- enddoc -%}

{% if product != blank and product.id != empty %}
  <wishlist-button
    class="wishlist-button{% if class != blank %} {{ class }}{% endif %}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
  >
    <button class="wishlist-button__trigger" type="button">
      <svg class="wishlist-button__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          class="wishlist-button__icon-outline"
          d="M12 20s-7-4.4-9.3-8.5C.8 8.2 2.7 4.5 6.3 4.5c2 0 3.4 1 4.3 2.3.9-1.3 2.3-2.3 4.3-2.3 3.6 0 5.5 3.7 3.6 7C19 15.6 12 20 12 20Z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
        />
        <path
          class="wishlist-button__icon-filled"
          d="M12 20s-7-4.4-9.3-8.5C.8 8.2 2.7 4.5 6.3 4.5c2 0 3.4 1 4.3 2.3.9-1.3 2.3-2.3 4.3-2.3 3.6 0 5.5 3.7 3.6 7C19 15.6 12 20 12 20Z"
          fill="currentColor"
        />
      </svg>
    </button>
  </wishlist-button>
{% endif %}
